<?xml version="1.0" encoding="UTF-8"?>
<addon id="webapp.duckduckgo" name="DuckDuckGo" version="1.0.0" provider-name="Daniel Golle">
  <extension point="kodi.webapp" starturl="https://duckduckgo.com/">
    <useragent>@USER_AGENT@</useragent>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">DuckDuckGo search inside Kodi</summary>
    <description lang="en_GB">Opens DuckDuckGo in Kodi's web view to search and browse the web. Back, forward and reload are in the web window's menu.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
  </extension>
</addon>
