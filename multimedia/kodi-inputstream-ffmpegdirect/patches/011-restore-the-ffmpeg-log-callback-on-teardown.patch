From cee72091e38b62e5415fdb0be25f2c3f52e4f8dc Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 18 Sep 2026 00:11:36 +0100
Subject: [PATCH] Stop logging into Kodi after the stream is gone

av_log_set_callback() sets a pointer that is global to the process, and
the add-on installed its own on every stream and never took it back, so
FFmpeg kept calling into the add-on after the stream that installed it
was destroyed. Playback died with SIGSEGV on the next channel change,
with the faulting instruction in the add-on's logging helper.

Count the streams that want the callback, install it for the first and
restore FFmpeg's default after the last. A thread already inside
av_log() can still reach the callback once that has happened, so it
returns immediately when no stream is left rather than reading ptr as an
AVClass, which by then belongs to a context that has been freed.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 src/stream/FFmpegLog.cpp    | 25 +++++++++++++++++++++++++
 src/stream/FFmpegLog.h      |  2 ++
 src/stream/FFmpegStream.cpp |  3 ++-
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/src/stream/FFmpegLog.cpp b/src/stream/FFmpegLog.cpp
index 95bd47f..0afbff7 100644
--- a/src/stream/FFmpegLog.cpp
+++ b/src/stream/FFmpegLog.cpp
@@ -43,8 +43,26 @@ int FFmpegLog::GetLogLevel()
 }
 
 static std::mutex m_ffmpegdirectLogMutex;
+static int g_ffmpegdirectLogUsers;
 std::map<const std::thread::id, std::string> g_ffmpegdirectLogbuffer;
 
+void ff_install_avutil_log(void)
+{
+  std::lock_guard<std::mutex> lock(m_ffmpegdirectLogMutex);
+
+  if (g_ffmpegdirectLogUsers++ == 0)
+    av_log_set_callback(ff_avutil_log);
+}
+
+void ff_restore_avutil_log(void)
+{
+  std::lock_guard<std::mutex> lock(m_ffmpegdirectLogMutex);
+
+  /* the callback is global to the process, so it must not outlive us */
+  if (--g_ffmpegdirectLogUsers == 0)
+    av_log_set_callback(av_log_default_callback);
+}
+
 void ff_flush_avutil_log_buffers(void)
 {
   std::lock_guard<std::mutex> lock(m_ffmpegdirectLogMutex);
@@ -62,6 +80,13 @@ void ff_flush_avutil_log_buffers(void)
 void ff_avutil_log(void* ptr, int level, const char* format, va_list va)
 {
   std::lock_guard<std::mutex> lock(m_ffmpegdirectLogMutex);
+
+  /* A thread that read the callback pointer before it was replaced still
+     arrives here afterwards, with ptr pointing into a context that went
+     away with the stream. */
+  if (g_ffmpegdirectLogUsers == 0)
+    return;
+
   const std::thread::id threadId = std::this_thread::get_id();
   std::string &buffer = g_ffmpegdirectLogbuffer[threadId];
 
diff --git a/src/stream/FFmpegLog.h b/src/stream/FFmpegLog.h
index 82f8b1b..09c0de7 100644
--- a/src/stream/FFmpegLog.h
+++ b/src/stream/FFmpegLog.h
@@ -18,6 +18,8 @@ extern "C" {
 // callback used for logging
 void ff_avutil_log(void* ptr, int level, const char* format, va_list va);
 void ff_flush_avutil_log_buffers(void);
+void ff_install_avutil_log(void);
+void ff_restore_avutil_log(void);
 
 namespace ffmpegdirect
 {
diff --git a/src/stream/FFmpegStream.cpp b/src/stream/FFmpegStream.cpp
index 38cbfd5..5a83116 100644
--- a/src/stream/FFmpegStream.cpp
+++ b/src/stream/FFmpegStream.cpp
@@ -155,13 +155,14 @@ FFmpegStream::FFmpegStream(IManageDemuxPacket* demuxPacketManager, const Propert
 
   FFmpegLog::SetLogLevel(AV_LOG_INFO);
   FFmpegLog::SetEnabled(kodi::addon::GetSettingBoolean("allowFFmpegLogging"));
-  av_log_set_callback(ff_avutil_log);
+  ff_install_avutil_log();
 }
 
 FFmpegStream::~FFmpegStream()
 {
   Dispose();
   ff_flush_avutil_log_buffers();
+  ff_restore_avutil_log();
 }
 
 bool FFmpegStream::Open(const std::string& streamUrl, const std::string& mimeType, bool isRealTimeStream, const std::string& programProperty)
-- 
