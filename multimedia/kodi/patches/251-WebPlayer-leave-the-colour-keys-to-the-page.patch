From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 5 Nov 2026 23:42:56 +0000
Subject: [PATCH] WebPlayer: leave the colour keys to the page

HbbTV and other TV pages drive their own menus with the red, green,
yellow and blue keys, which the keymap binds globally to Kodi
commands. The web player hands those keys to the page while its
window is in front, as it does with keys that type a character.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/cores/WebPlayer/WebPlayer.cpp | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

--- a/xbmc/cores/WebPlayer/WebPlayer.cpp
+++ b/xbmc/cores/WebPlayer/WebPlayer.cpp
@@ -58,7 +58,8 @@ constexpr int RENDER_BUFFERS = 3;
 
 // The web window's keymap section claims keys for Kodi outright. Of the
 // others, a key bound globally to a Kodi command or to the volume stays
-// with Kodi as well, unless it types a character into the page.
+// with Kodi as well, unless it types a character into the page or is one of
+// the colour keys, which TV pages use for their own menus.
 bool IsKodiKey(const XBMC_keysym& keysym, const CKey& key)
 {
   CInputManager& input = CServiceBroker::GetInputManager();
@@ -68,6 +69,17 @@ bool IsKodiKey(const XBMC_keysym& keysym
   if (keysym.unicode >= 0x20 && keysym.unicode != 0x7f)
     return false;
 
+  switch (keysym.sym)
+  {
+    case XBMCK_RED:
+    case XBMCK_GREEN:
+    case XBMCK_YELLOW:
+    case XBMCK_BLUE:
+      return false;
+    default:
+      break;
+  }
+
   switch (input.GetAction(WINDOW_FULLSCREEN_WEB, key, true).GetID())
   {
     case ACTION_BUILT_IN_FUNCTION:
