+                          if it.attr("type") in ("int", "long", "unsigned int", "unsigned long", "bool")
+                          else "PyModule_AddStringConstant")
+                e('\n   %s(module,"%s",%s); ' % (pyCall, it.attr("sym_name"), it.attr("value")))
