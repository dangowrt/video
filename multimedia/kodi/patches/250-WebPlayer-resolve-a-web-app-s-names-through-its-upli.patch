From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 5 Nov 2026 23:42:56 +0000
Subject: [PATCH] WebPlayer: resolve a web app's names through its uplink

A web app pinned to an uplink gets a view bound to that uplink, but the
web client resolves its hostnames with the system resolver over the
default route. The client now starts with uplinkdns preloaded and the
uplinks of the installed web apps in its environment, so that its
network process resolves each view's names through the uplink the
view is bound to. A web app whose uplink does not resolve is not
opened, and a notification names the missing uplink.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../resources/strings.po                      |  8 ++-
 xbmc/cores/WebPlayer/WebClientManager.cpp     | 50 +++++++++++++++++++
 2 files changed, 57 insertions(+), 1 deletion(-)

--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25770,7 +25770,13 @@ msgctxt "#40248"
 msgid "Reload"
 msgstr ""
 
-#empty strings from id 40249 to 40399
+#empty strings from id 40249 to 40398
+
+#. Notification text when a web app's uplink has no local address
+#: xbmc/cores/WebPlayer/WebClientManager.cpp
+msgctxt "#40399"
+msgid "The uplink {0:s} is not available."
+msgstr ""
 
 # Video versions
 
--- a/xbmc/cores/WebPlayer/WebClientManager.cpp
+++ b/xbmc/cores/WebPlayer/WebClientManager.cpp
@@ -27,6 +27,7 @@
 #include "jobs/JobManager.h"
 #include "kodi-web-audio.h"
 #include "kodi-web-video.h"
+#include "network/UplinkAddress.h"
 #include "resources/LocalizeStrings.h"
 #include "resources/ResourcesComponent.h"
 #include "settings/Settings.h"
@@ -55,15 +56,21 @@
 
 #include <algorithm>
 #include <cmath>
+#include <cstdlib>
 #include <limits>
 #include <mutex>
 #include <utility>
 
 #include <fcntl.h>
+#include <sys/socket.h>
 #include <sys/stat.h>
 #include <unistd.h>
 #include <xf86drm.h>
 
+#if defined(HAS_UPLINKDNS)
+#include <uplinkdns.h>
+#endif
+
 using namespace KODI::WEB;
 using namespace KODI::WAYLANDHOST;
 
@@ -131,6 +138,33 @@ std::string CdmDirectory()
   return path.empty() ? path : CSpecialProtocol::TranslatePath(path);
 }
 
+void AddUplinkEnvironment(std::map<std::string, std::string>& env)
+{
+#if defined(HAS_UPLINKDNS)
+  ADDON::VECADDONS addons;
+  CServiceBroker::GetAddonMgr().GetAddons(addons, ADDON::AddonType::WEBAPP);
+
+  std::string uplinks;
+  for (const auto& addon : addons)
+  {
+    const std::string uplink = addon->GetSetting("uplinkaddress");
+    if (!uplink.empty())
+      uplinks += (uplinks.empty() ? "" : " ") + uplink;
+  }
+
+  // the client's network process resolves each session's names through the uplink it binds to
+  if (uplinks.empty())
+    return;
+
+  std::string preload = UPLINKDNS_SONAME;
+  if (const char* inherited = std::getenv("LD_PRELOAD"); inherited && *inherited)
+    preload = std::string(inherited) + " " + preload;
+
+  env.emplace("LD_PRELOAD", preload);
+  env.emplace("UPLINKDNS_UPLINKS", uplinks);
+#endif
+}
+
 void NotifyOpenError(const std::string& profile, const std::string& reason)
 {
   ADDON::AddonPtr addon;
@@ -144,6 +178,16 @@ void NotifyOpenError(const std::string&
       CGUIDialogKaiToast::Error, StringUtils::Format(localizeStrings.Get(13329), name), reason);
 }
 
+void NotifyUplinkMissing(const std::string& profile, const std::string& uplink)
+{
+  CLog::Log(LOGERROR, "CWebClientManager::{}: the uplink \"{}\" of {} does not resolve",
+            __FUNCTION__, uplink, profile);
+
+  const auto& localizeStrings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  // "The uplink {0:s} is not available."
+  NotifyOpenError(profile, StringUtils::Format(localizeStrings.Get(40399), uplink));
+}
+
 const ADDON::CAddonType* WebAppType(const std::shared_ptr<ADDON::CAddon>& webapp)
 {
   return webapp ? webapp->Type(ADDON::AddonType::WEBAPP) : nullptr;
@@ -314,6 +358,7 @@ void CWebClientManager::Spawn()
   // pages decrypt with the CDM that inputstream.adaptive installed
   if (const std::string cdm = CdmDirectory(); !cdm.empty())
     env.emplace("KODI_WEB_CDM_DIR", cdm);
+  AddUplinkEnvironment(env);
   m_host->SpawnClient({command}, std::move(env));
 }
 
@@ -336,6 +381,11 @@ bool CWebClientManager::RequestView(cons
   }
 
   const std::string uplink = UplinkOf(profile);
+  if (!uplink.empty() && !KODI::NETWORK::ResolveUplink(uplink, AF_UNSPEC).IsValid())
+  {
+    NotifyUplinkMissing(profile, uplink);
+    return false;
+  }
 
   std::unique_lock lock(m_lock);
   m_observer = &observer;
