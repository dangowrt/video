       CloseAll(fds);
       Clear();
       return true;
+    case KODI_WEB_VIDEO_RECT:
+    {
+      kodi_web_video_rect rect;
+      CloseAll(fds);
+      if (static_cast<size_t>(len) != sizeof(rect))
+        return false;
+      memcpy(&rect, message, sizeof(rect));
