 xbmc/cores/WebPlayer/WebLayerBridge.h   | 17 ++++++
 xbmc/cores/WebPlayer/WebPlayer.cpp      |  7 +++
 xbmc/cores/WebPlayer/WebPlayer.h        |  1 +
