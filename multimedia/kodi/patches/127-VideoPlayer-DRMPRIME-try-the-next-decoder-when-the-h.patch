 .../VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp |   2 +-
 .../DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp | 118 ++++++++++++++----
 .../DVDCodecs/Video/DVDVideoCodecDRMPRIME.h   |  13 ++
 xbmc/cores/VideoPlayer/DVDStreamInfo.h        |   2 +
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp   |  35 +++++-
 5 files changed, 140 insertions(+), 30 deletions(-)

--- a/xbmc/cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/DVDFactoryCodec.cpp
@@ -69,7 +69,7 @@ std::unique_ptr<CDVDVideoCodec> CDVDFact
   }
 
   // platform specific video decoders
-  if (!(hint.codecOptions & CODEC_FORCE_SOFTWARE))
+  if (!(hint.codecOptions & (CODEC_FORCE_SOFTWARE | CODEC_SKIP_HW_CODECS)))
   {
     for (auto &codec : m_hwVideoCodecs)
     {
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.cpp
@@ -100,6 +100,17 @@ CDVDVideoCodecDRMPRIME::~CDVDVideoCodecD
   avcodec_free_context(&m_pCodecContext);
 }
 
+void CDVDVideoCodecDRMPRIME::Reopen()
+{
+  av_frame_unref(m_pFrame);
+  avcodec_free_context(&m_pCodecContext);
+  m_packetsSinceOpen = 0;
+  m_pictureDecoded = false;
+
+  if (!Open(m_hints, m_options))
+    CLog::Log(LOGERROR, "CDVDVideoCodecDRMPRIME::{} - unable to reopen the decoder", __FUNCTION__);
+}
+
 std::unique_ptr<CDVDVideoCodec> CDVDVideoCodecDRMPRIME::Create(CProcessInfo& processInfo)
 {
   if (CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
@@ -181,25 +192,34 @@ static const AVCodecHWConfig* FindHWConf
   return nullptr;
 }
 
-static const AVCodec* FindDecoder(CDVDStreamInfo& hints)
+static const AVCodec* FindHWDecoder(const CDVDStreamInfo& hints, const std::set<std::string>& skip)
 {
   const AVCodec* codec = nullptr;
   void* i = 0;
 
-  if (!(hints.codecOptions & CODEC_FORCE_SOFTWARE))
-    while ((codec = av_codec_iterate(&i)))
-    {
-      if (!av_codec_is_decoder(codec))
-        continue;
-      if (codec->id != hints.codec)
-        continue;
-
-      const AVCodecHWConfig* config = FindHWConfig(codec);
-      if (config)
-        return codec;
-    }
+  if (hints.codecOptions & CODEC_FORCE_SOFTWARE)
+    return nullptr;
 
-  codec = avcodec_find_decoder(hints.codec);
+  while ((codec = av_codec_iterate(&i)))
+  {
+    if (!av_codec_is_decoder(codec))
+      continue;
+    if (codec->id != hints.codec)
+      continue;
+    if (skip.contains(codec->name))
+      continue;
+
+    const AVCodecHWConfig* config = FindHWConfig(codec);
+    if (config)
+      return codec;
+  }
+
+  return nullptr;
+}
+
+static const AVCodec* FindSWDecoder(const CDVDStreamInfo& hints)
+{
+  const AVCodec* codec = avcodec_find_decoder(hints.codec);
   if (codec && (codec->capabilities & AV_CODEC_CAP_DR1) == AV_CODEC_CAP_DR1)
     return codec;
 
@@ -209,11 +229,22 @@ static const AVCodec* FindDecoder(CDVDSt
 enum AVPixelFormat CDVDVideoCodecDRMPRIME::GetFormat(struct AVCodecContext* avctx,
                                                      const enum AVPixelFormat* fmt)
 {
+  CDVDVideoCodecDRMPRIME* ctx = static_cast<CDVDVideoCodecDRMPRIME*>(avctx->opaque);
+  bool hwOffered = false;
+
+  for (int n = 0; fmt[n] != AV_PIX_FMT_NONE; ++n)
+    hwOffered |= ctx->m_hwDecoder && IsSupportedHwFormat(fmt[n]);
+
+  // ffmpeg asks again without the hardware format once the hwaccel fails to initialise
+  if (hwOffered)
+    ctx->m_hwFormatOffered = true;
+  else if (ctx->m_hwFormatOffered)
+    ctx->m_hwFormatFailed = true;
+
   for (int n = 0; fmt[n] != AV_PIX_FMT_NONE; n++)
   {
-    if (IsSupportedHwFormat(fmt[n]) || IsSupportedSwFormat(fmt[n]))
+    if ((ctx->m_hwDecoder && IsSupportedHwFormat(fmt[n])) || IsSupportedSwFormat(fmt[n]))
     {
-      CDVDVideoCodecDRMPRIME* ctx = static_cast<CDVDVideoCodecDRMPRIME*>(avctx->opaque);
       ctx->UpdateProcessInfo(avctx, fmt[n]);
       return fmt[n];
     }
@@ -227,6 +258,7 @@ enum AVPixelFormat CDVDVideoCodecDRMPRIM
   CLog::Log(LOGERROR, "CDVDVideoCodecDRMPRIME::{} - no supported pixel formats: {}", __FUNCTION__,
             StringUtils::Join(formats, ", "));
 
+  ctx->m_noSupportedFormat = true;
   return AV_PIX_FMT_NONE;
 }
 
@@ -289,7 +321,10 @@ int CDVDVideoCodecDRMPRIME::GetBuffer(st
 
 bool CDVDVideoCodecDRMPRIME::Open(CDVDStreamInfo& hints, CDVDCodecOptions& options)
 {
-  const AVCodec* pCodec = FindDecoder(hints);
+  const AVCodec* pCodec = FindHWDecoder(hints, m_skipDecoders);
+  m_hwDecoder = pCodec != nullptr;
+  if (!pCodec)
+    pCodec = FindSWDecoder(hints);
   if (!pCodec)
   {
     CLog::Log(LOGDEBUG, "CDVDVideoCodecDRMPRIME::{} - unable to find decoder for codec {}",
@@ -305,8 +340,12 @@ bool CDVDVideoCodecDRMPRIME::Open(CDVDSt
     return false;
 
   m_hints = hints;
+  m_options = options;
+  m_hwFormatOffered = false;
+  m_hwFormatFailed = false;
+  m_noSupportedFormat = false;
 
-  const AVCodecHWConfig* pConfig = FindHWConfig(pCodec);
+  const AVCodecHWConfig* pConfig = m_hwDecoder ? FindHWConfig(pCodec) : nullptr;
   if (pConfig && (pConfig->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX))
   {
     const char* type = av_hwdevice_get_type_name(pConfig->device_type);
@@ -383,10 +422,10 @@ bool CDVDVideoCodecDRMPRIME::Open(CDVDSt
   {
     CLog::Log(LOGINFO, "CDVDVideoCodecDRMPRIME::{} - unable to open codec", __FUNCTION__);
     avcodec_free_context(&m_pCodecContext);
-    if (hints.codecOptions & CODEC_FORCE_SOFTWARE)
+    if (!m_hwDecoder)
       return false;
 
-    hints.codecOptions |= CODEC_FORCE_SOFTWARE;
+    m_skipDecoders.insert(pCodec->name);
     return Open(hints, options);
   }
 
@@ -413,11 +452,11 @@ void CDVDVideoCodecDRMPRIME::UpdateProce
 
 bool CDVDVideoCodecDRMPRIME::AddData(const DemuxPacket& packet)
 {
-  if (!m_pCodecContext)
-    return true;
-
-  if (!packet.pData)
+  if (!m_pCodecContext || !packet.pData)
+  {
+    m_packetsSinceOpen++;
     return true;
+  }
 
   AVPacket* avpkt = av_packet_alloc();
   if (!avpkt)
@@ -458,6 +497,7 @@ bool CDVDVideoCodecDRMPRIME::AddData(con
       return false;
   }
 
+  m_packetsSinceOpen++;
   return true;
 }
 
@@ -630,6 +670,34 @@ void CDVDVideoCodecDRMPRIME::SetPictureP
 
 CDVDVideoCodec::VCReturn CDVDVideoCodecDRMPRIME::GetPicture(VideoPicture* pVideoPicture)
 {
+  if (!m_pCodecContext)
+    return VC_FATAL;
+
+  if (m_hwFormatFailed)
+  {
+    m_hwFormatFailed = false;
+
+    std::set<std::string> skip = m_skipDecoders;
+    skip.insert(m_pCodecContext->codec->name);
+
+    const AVCodec* next = FindHWDecoder(m_hints, skip);
+    if (next)
+    {
+      CLog::Log(LOGINFO,
+                "CDVDVideoCodecDRMPRIME::{} - hwaccel of decoder {} failed, reopening with {}",
+                __FUNCTION__, m_pCodecContext->codec->name, next->name);
+      m_skipDecoders = std::move(skip);
+      return VC_REOPEN;
+    }
+  }
+
+  if (m_noSupportedFormat)
+  {
+    CLog::Log(LOGINFO, "CDVDVideoCodecDRMPRIME::{} - decoder {} has no supported pixel format",
+              __FUNCTION__, m_pCodecContext->codec->name);
+    return VC_FATAL;
+  }
+
   if (m_codecControlFlags & DVD_CODEC_CTRL_DRAIN)
     Drain();
 
@@ -655,6 +723,8 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecD
     return VC_ERROR;
   }
 
+  m_pictureDecoded = true;
+
   // ffmpeg's v4l2m2m resizes without re-invoking our GetFormat callback; republish from the frames
   int piWidth, piHeight;
   m_processInfo.GetVideoDimensions(piWidth, piHeight);
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecDRMPRIME.h
@@ -9,10 +9,13 @@
 #pragma once
 
 #include "cores/VideoPlayer/Buffers/VideoBuffer.h"
+#include "cores/VideoPlayer/DVDCodecs/DVDCodecs.h"
 #include "cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h"
 #include "cores/VideoPlayer/DVDStreamInfo.h"
 
 #include <memory>
+#include <set>
+#include <string>
 
 class CVideoBufferPoolDMA;
 class CVideoBufferPoolDRMPRIMEFFmpeg;
@@ -30,7 +33,9 @@ public:
   bool AddData(const DemuxPacket& packet) override;
   void Reset() override;
   CDVDVideoCodec::VCReturn GetPicture(VideoPicture* pVideoPicture) override;
+  void Reopen() override;
   const char* GetName() override { return m_name.c_str(); }
+  unsigned GetConvergeCount() override { return m_pictureDecoded ? 0 : m_packetsSinceOpen; }
   unsigned GetAllowedReferences() override { return 5; }
   void SetCodecControl(int flags) override;
 
@@ -44,6 +49,14 @@ protected:
   std::string m_name;
   int m_codecControlFlags = 0;
   CDVDStreamInfo m_hints;
+  CDVDCodecOptions m_options;
+  std::set<std::string> m_skipDecoders;
+  bool m_hwDecoder = false;
+  bool m_hwFormatOffered = false;
+  bool m_hwFormatFailed = false;
+  bool m_noSupportedFormat = false;
+  unsigned m_packetsSinceOpen = 0;
+  bool m_pictureDecoded = false;
   double m_DAR = 1.0;
   AVCodecContext* m_pCodecContext = nullptr;
   AVFrame* m_pFrame = nullptr;
--- a/xbmc/cores/VideoPlayer/DVDStreamInfo.h
+++ b/xbmc/cores/VideoPlayer/DVDStreamInfo.h
@@ -19,6 +19,8 @@ extern "C"
 #define CODEC_FORCE_SOFTWARE 0x01
 #define CODEC_ALLOW_FALLBACK 0x02
 
+#define CODEC_SKIP_HW_CODECS 0x08
+
 class CDemuxStream;
 struct DemuxCryptoSession;
 
--- a/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp
@@ -626,6 +626,10 @@ void CVideoPlayerVideo::Process()
               m_packets.size() * frametime > DVD_SEC_TO_TIME(10))
             m_packets.pop_front();
         }
+        else
+        {
+          m_packets.clear();
+        }
 
         m_videoStats.AddSampleBytes(pPacket->iSize);
         UpdatePlayerInfo();
@@ -679,16 +683,37 @@ bool CVideoPlayerVideo::ProcessDecoderOu
     return false;
   }
 
-  if (decoderState == CDVDVideoCodec::VC_REOPEN)
+  if (decoderState == CDVDVideoCodec::VC_REOPEN ||
+      (decoderState == CDVDVideoCodec::VC_FATAL &&
+       !(m_hints.codecOptions & (CODEC_FORCE_SOFTWARE | CODEC_SKIP_HW_CODECS))))
   {
+    // in order, ahead of packets that an earlier reopen resent and that are still queued
     while (!m_packets.empty())
     {
-      auto msg = std::static_pointer_cast<CDVDMsgDemuxerPacket>(m_packets.front().message);
-      m_packets.pop_front();
-      SendMessage(msg, 10);
+      auto msg = std::static_pointer_cast<CDVDMsgDemuxerPacket>(m_packets.back().message);
+      m_packets.pop_back();
+      SendMessageBack(msg, 10);
     }
 
-    m_pVideoCodec->Reopen();
+    if (decoderState == CDVDVideoCodec::VC_REOPEN)
+    {
+      m_pVideoCodec->Reopen();
+    }
+    else
+    {
+      CLog::Log(LOGWARNING,
+                "CVideoPlayerVideo - video decoder {} failed, opening the stream without "
+                "platform video codecs",
+                m_pVideoCodec->GetName());
+      CDVDStreamInfo hint(m_hints);
+      hint.codecOptions |= CODEC_SKIP_HW_CODECS;
+      OpenStream(hint, nullptr);
+      if (m_picture.videoBuffer)
+      {
+        m_picture.videoBuffer->Release();
+        m_picture.videoBuffer = nullptr;
+      }
+    }
     m_packets.clear();
     m_renderManager.DiscardBuffer();
     return false;
