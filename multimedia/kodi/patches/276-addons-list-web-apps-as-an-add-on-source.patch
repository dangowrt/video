From 4d6dc401d05962fbc662e42836691597d1e49f00 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Wed, 28 Oct 2026 13:51:20 +0000
Subject: [PATCH 276/277] addons: list web apps as an add-on source

Skins build their add-on menus and home widgets from
addons://sources/<content>/, which knows plugins, scripts and games, so
an installed web app shows up nowhere but the add-on browser.
addons://sources/webapp/ lists the enabled web apps as webapp://<id>
items, which open through RunAddon from a list, a widget or a
favourite, and addons://more/webapp browses the web apps of every
repository. RunAddon marks a web app as used, so lists sorted by last
use put the app opened last first.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/filesystem/AddonsDirectory.cpp        | 16 ++++++++++++++--
 xbmc/interfaces/builtins/AddonBuiltins.cpp |  1 +
 xbmc/utils/ExecString.cpp                  |  2 ++
 xbmc/windows/GUIMediaWindow.cpp            |  9 +++++++++
 4 files changed, 26 insertions(+), 2 deletions(-)

--- a/xbmc/filesystem/AddonsDirectory.cpp
+++ b/xbmc/filesystem/AddonsDirectory.cpp
@@ -787,6 +787,8 @@ bool CAddonsDirectory::GetDirectory(cons
       return Browse(CURL("addons://all/xbmc.addon." + type), items);
     else if (type == "game")
       return Browse(CURL("addons://all/category.gameaddons"), items);
+    else if (type == "webapp")
+      return Browse(CURL("addons://all/kodi.webapp"), items);
     return false;
   }
   else
@@ -914,6 +916,12 @@ CFileItemPtr CAddonsDirectory::FileItemF
 
