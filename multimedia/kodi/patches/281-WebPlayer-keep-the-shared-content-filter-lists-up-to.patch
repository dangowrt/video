+
+namespace KODI
+{
+namespace WAYLANDHOST
+{
+class CWaylandHost;
+}
+
+namespace WEB
+{
+
+/*!
+ * \brief Keeps the shared content filter lists named in advancedsettings.xml
+ * in the profile and hands them to the web client. The lists are fetched
+ * once the system clock is synchronised, and again once a day.
+ */
+class CWebFilterLists : private CThread
+{
+public:
+  explicit CWebFilterLists(WAYLANDHOST::CWaylandHost& host);
+  ~CWebFilterLists() override;
+
+  void Start();
+
+  /*!
+   * \brief A web app asks for a list; one Kodi never had is fetched as soon
+   * as the clock allows; any thread
+   */
+  void Want(const std::string& name);
+
+protected:
+  void Process() override;
+
+private:
+  void Publish();
+  void FetchAll();
+  bool Fetch(const std::string& name, const std::string& url);
+  void ArmClockChange();
+  void Wake();
+  static bool IsClockSynchronised();
+
+  WAYLANDHOST::CWaylandHost& m_host;
+  std::map<std::string, std::string> m_lists;
+  std::string m_dir;
+  int m_wakeFd{-1};
+  int m_clockFd{-1};
+  CCriticalSection m_lock;
+  std::set<std::string> m_missing;
+};
+
+} // namespace WEB
+} // namespace KODI
