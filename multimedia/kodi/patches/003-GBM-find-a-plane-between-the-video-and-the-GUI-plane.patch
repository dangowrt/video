From 24b60a2e604b1388fe4d4c19096513c058a88ef6 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 5 Nov 2026 23:25:35 +0000
Subject: [PATCH] GBM: find a plane between the video and the GUI plane

A client that composes a layer of its own over the video, such as a web
page with its video on the video plane, needs a third plane stacked
between the video and the GUI plane. FindOverlayPlane() picks a free
plane of the CRTC for the layer's format, and GetVideoFormats() lists
what the planes besides the GUI plane can show, each format in its
linear layout before any modifier, so that a client taking only the
first entries still gets every format. MoveOnTopOf() moves two planes to
the ends of their zpos ranges, which leaves no level in between, so the
three planes get the lowest, a middle and the highest level instead,
around any of them whose zpos is fixed.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/windowing/gbm/drm/DRMPlane.h   |  4 ++
 xbmc/windowing/gbm/drm/DRMUtils.cpp | 84 +++++++++++++++++++++++++++++
 xbmc/windowing/gbm/drm/DRMUtils.h   |  4 ++
 3 files changed, 92 insertions(+)

--- a/xbmc/windowing/gbm/drm/DRMPlane.h
+++ b/xbmc/windowing/gbm/drm/DRMPlane.h
@@ -48,6 +48,10 @@ public:
   void SetModifier(const uint64_t newModifier) { m_modifier = newModifier; }
   uint64_t GetModifier() const { return m_modifier; }
   std::vector<uint64_t>& GetModifiersForFormat(uint32_t format) { return m_modifiers_map[format]; }
+  std::vector<uint32_t> GetFormats() const
+  {
+    return {m_plane->formats, m_plane->formats + m_plane->count_formats};
+  }
 
   bool SupportsFormat(uint32_t format);
   bool SupportsFormatAndModifier(uint32_t format, uint64_t modifier);
--- a/xbmc/windowing/gbm/drm/DRMUtils.cpp
+++ b/xbmc/windowing/gbm/drm/DRMUtils.cpp
@@ -16,6 +16,8 @@
 #include "utils/log.h"
 #include "windowing/GraphicContext.h"
 
+#include <algorithm>
+
 #include "PlatformDefs.h"
 
 using namespace KODI::WINDOWING::GBM;
@@ -37,6 +39,28 @@ void DrmFbDestroyCallback(gbm_bo* bo, vo
 
   delete fb;
 }
+
+// pairwise moves on top of each other leave no level in between, so three
+// planes get the lowest, a middle and the highest level of their ranges,
+// around any plane whose level is fixed
+bool StackPlanes(CDRMPlane* bottom, CDRMPlane* middle, CDRMPlane* top)
+{
+  const auto level = [](CDRMPlane* plane) { return plane->GetPropertyValue("zpos").value_or(0); };
+  const auto fixed = [](CDRMPlane* plane)
+  { return plane->IsPropertyImmutable("zpos").value_or(true); };
+  const auto range = [](CDRMPlane* plane)
+  { return plane->GetRangePropertyLimits("zpos").value_or(std::pair<uint64_t, uint64_t>(0, 0)); };
+
+  const uint64_t low = fixed(bottom) ? level(bottom) : range(bottom).first;
+  const uint64_t high = fixed(top) ? level(top) : range(top).second;
+  const uint64_t mid = fixed(middle) ? level(middle) : std::max(range(middle).first, low + 1);
+  if (mid <= low || mid >= high || (!fixed(middle) && mid > range(middle).second))
+    return false;
+
+  return (fixed(bottom) || bottom->SetProperty("zpos", low)) &&
+         (fixed(middle) || middle->SetProperty("zpos", mid)) &&
+         (fixed(top) || top->SetProperty("zpos", high));
+}
 } // namespace
 
 CDRMUtils::~CDRMUtils()
@@ -368,6 +392,66 @@ bool CDRMUtils::FindVideoAndGuiPlane(uin
   return false;
 }
 
+std::vector<std::pair<uint32_t, uint64_t>> CDRMUtils::GetVideoFormats()
+{
+  std::vector<std::pair<uint32_t, uint64_t>> formats;
+  const auto add = [&formats](uint32_t format, uint64_t modifier)
+  {
+    if (std::ranges::find(formats, std::make_pair(format, modifier)) == formats.end())
+      formats.emplace_back(format, modifier);
+  };
+
+  std::vector<CDRMPlane*> planes;
+  for (auto& plane : m_planes)
+  {
+    if (plane.get() != m_gui_plane &&
+        plane->Check(0, 0, DRM_FORMAT_INVALID, DRM_FORMAT_MOD_INVALID, m_crtc, PLANE_TYPE_ANY))
+      planes.emplace_back(plane.get());
+  }
+
+  // each format in its linear layout first, so that a client taking only so
+  // many entries still gets every format
+  for (auto* plane : planes)
+  {
+    for (uint32_t format : plane->GetFormats())
+      add(format, DRM_FORMAT_MOD_LINEAR);
+  }
+  for (auto* plane : planes)
+  {
+    for (uint32_t format : plane->GetFormats())
+    {
+      for (uint64_t modifier : plane->GetModifiersForFormat(format))
+        add(format, modifier);
+    }
+  }
+  return formats;
+}
+
+CDRMPlane* CDRMUtils::FindOverlayPlane(uint32_t format,
+                                       uint64_t modifier,
+                                       uint64_t width,
+                                       uint64_t height)
+{
+  if (!m_video_plane || !m_gui_plane)
+    return nullptr;
+
+  for (auto& plane : m_planes)
+  {
+    if (plane.get() == m_video_plane || plane.get() == m_gui_plane ||
+        !plane->Check(width, height, format, modifier, m_crtc, PLANE_TYPE_ANY) ||
+        !StackPlanes(m_video_plane, plane.get(), m_gui_plane))
+      continue;
+
+    plane->SetFormat(format);
+    plane->SetModifier(modifier);
+    CLog::LogF(LOGINFO,
+               "Using overlay plane [{}x{}] id:{} between video plane id:{} and gui plane id:{}",
+               width, height, plane->GetId(), m_video_plane->GetId(), m_gui_plane->GetId());
+    return plane.get();
+  }
+  return nullptr;
+}
+
 void CDRMUtils::PrintDrmDeviceInfo(drmDevicePtr device)
 {
   std::string message;
--- a/xbmc/windowing/gbm/drm/DRMUtils.h
+++ b/xbmc/windowing/gbm/drm/DRMUtils.h
@@ -75,6 +75,10 @@ public:
   // FindGuiPlane never releases a D2P video plane reservation; a caller that
   // means "video is over" states it here before revalidating the gui plane.
   void ReleaseVideoPlane() { m_video_plane = nullptr; }
+  //! \brief The formats and modifiers a plane besides the GUI plane shows on the CRTC
+  std::vector<std::pair<uint32_t, uint64_t>> GetVideoFormats();
+  //! \brief A free plane stacked between the video and the GUI plane, or nullptr
+  CDRMPlane* FindOverlayPlane(uint32_t format, uint64_t modifier, uint64_t width, uint64_t height);
   bool HasQuirk(int quirk) const { return m_drm_quirks & quirk; }
 
   std::vector<std::string> GetConnectedConnectorNames();
