From bf3a43dde98813991438e7e7e9f7df310ede04d9 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Mon, 9 Nov 2026 14:06:58 +0000
Subject: [PATCH] [builtins] Wake the display when RunAddon opens a web app

RunAddon opens a web app with PlayMedia() directly, so the display
stayed off when a web app was started while it was switched off, for
example from a remote control app. Like the PlayMedia builtin, RunAddon
resets the screensaver and wakes the display before it shows the app.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/interfaces/builtins/AddonBuiltins.cpp | 5 +++++
 1 file changed, 5 insertions(+)

--- a/xbmc/interfaces/builtins/AddonBuiltins.cpp
+++ b/xbmc/interfaces/builtins/AddonBuiltins.cpp
@@ -24,6 +24,7 @@
 #include "application/Application.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationPlayer.h"
+#include "application/ApplicationPowerHandling.h"
 #include "cores/WebPlayer/WebApp.h"
 #include "cores/WebPlayer/WebPlayerDefs.h"
 #include "filesystem/PluginDirectory.h"
@@ -190,6 +191,10 @@ static int RunAddon(const std::vector<st
       const auto webapp = std::dynamic_pointer_cast<CAddon>(addon);
       CServiceBroker::GetAddonMgr().UpdateLastUsed(addonid);
       const auto appPlayer = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+      const auto appPower =
+          CServiceBroker::GetAppComponents().GetComponent<CApplicationPowerHandling>();
+      appPower->ResetScreenSaver();
+      appPower->WakeUpScreenSaverAndDPMS();
       // a web app already shown comes back as it was, playing or not
       if (params.size() < 2 && appPlayer->IsWebPlaying() &&
           g_application.CurrentFileItem().GetProperty(KODI::WEB::PROPERTY_PROFILE).asString() ==
