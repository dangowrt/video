From cb55832994e26abe8ab9ce1b476bc3d12404e6e9 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sun, 8 Nov 2026 23:42:30 +0000
Subject: [PATCH] WebPlayer: let each web app allow software video decoding

Web apps choose among the video codecs the browser offers, and the
browser offers every codec a decoder handles, software decoders
included. On a Raspberry Pi 4 YouTube thus picks VP9, which only a
software decoder handles, and plays HD video at a fraction of its
frame rate, although the hardware decodes H.264.

Kodi gives every web app the setting "Allow software decoding", off by
default, and passes it to the browser with the
set_software_video_decoding event of kodi_web_v1 version 4. Off, the
browser offers only the codecs it decodes in hardware; video that a
DRM module decodes itself is not affected. Kodi sends the setting when
it configures a view and when it shows a view again, so that a changed
setting applies from the view's next navigation.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../resources/strings.po                      | 26 ++++++++++++++++++-
 system/settings/webapp.xml                    |  9 +++++++
 xbmc/cores/WebPlayer/WebClientManager.cpp     | 13 ++++++++++
 xbmc/cores/WebPlayer/WebClientManager.h       |  1 +
 .../linux/waylandhost/WaylandHost.cpp         | 14 +++++++++-
 xbmc/platform/linux/waylandhost/WaylandHost.h |  1 +
 .../waylandhost/protocol/kodi-web-v1.xml      | 17 ++++++++++--
 7 files changed, 77 insertions(+), 4 deletions(-)

--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25842,7 +25842,31 @@ msgctxt "#40260"
 msgid "The web app's file {0:s} is missing or cannot be used."
 msgstr ""
 
-#empty strings from id 40261 to 40398
+#. Label of the category of the video settings Kodi gives every web app
+#: system/settings/webapp.xml
+msgctxt "#40261"
+msgid "Video"
+msgstr ""
+
+#. Help text of the category of the video settings Kodi gives every web app
+#: system/settings/webapp.xml
+msgctxt "#40262"
+msgid "How the app plays video."
+msgstr ""
+
+#. Label of the setting that lets a web app play video decoded in software
+#: system/settings/webapp.xml
+msgctxt "#40263"
+msgid "Allow software decoding"
+msgstr ""
+
+#. Help text of the setting that lets a web app play video decoded in software
+#: system/settings/webapp.xml
+msgctxt "#40264"
+msgid "Let the app play video that only a software decoder can decode. Off offers the app only the codecs the hardware decodes, so that an app choosing among several picks one of those; on most devices software decoding cannot keep up with high definition video. Video that a DRM module such as Widevine decodes itself is not affected."
+msgstr ""
+
+#empty strings from id 40265 to 40398
 
 #. Notification text when a web app's uplink has no local address
 #: xbmc/cores/WebPlayer/WebClientManager.cpp
--- a/system/settings/webapp.xml
+++ b/system/settings/webapp.xml
@@ -13,5 +13,14 @@
         </setting>
       </group>
     </category>
+    <category id="video" label="40261" help="40262">
+      <group id="1">
+        <setting id="softwarevideodecoding" type="boolean" label="40263" help="40264">
+          <level>2</level>
+          <default>false</default>
+          <control type="toggle" />
+        </setting>
+      </group>
+    </category>
   </section>
 </settings>
--- a/xbmc/cores/WebPlayer/WebClientManager.cpp
+++ b/xbmc/cores/WebPlayer/WebClientManager.cpp
@@ -680,6 +680,7 @@ bool CWebClientManager::RequestView(cons
   {
     CWaylandSurface& surface = *view->second;
     lock.unlock();
+    SendSoftwareVideoDecoding(profile);
     observer.OnWebViewAvailable(profile, surface);
     return true;
   }
@@ -927,6 +928,16 @@ std::string CWebClientManager::UplinkOf(
   return addon->GetSetting("uplinkaddress");
 }
 
+void CWebClientManager::SendSoftwareVideoDecoding(const std::string& profile)
+{
+  ADDON::AddonPtr addon;
+  bool allowed = false;
+  if (CServiceBroker::GetAddonMgr().GetAddon(profile, addon, ADDON::AddonType::WEBAPP,
+                                             ADDON::OnlyEnabled::CHOICE_YES) &&
+      addon->GetSettingBool("softwarevideodecoding", allowed))
+    m_host->WebViewSetSoftwareVideoDecoding(profile, allowed);
+}
+
 bool CWebClientManager::ConfigureViewFromAddon(const std::string& profile)
 {
   ADDON::AddonPtr addon;
@@ -946,6 +957,8 @@ bool CWebClientManager::ConfigureViewFro
   if (!userAgent.empty())
     m_host->WebViewSetUserAgent(profile, userAgent);
 
+  SendSoftwareVideoDecoding(profile);
+
   std::vector<WebAppFile> files;
   std::string failed;
   if (!WebAppFilesOf(addon, *type, files, failed))
--- a/xbmc/cores/WebPlayer/WebClientManager.h
+++ b/xbmc/cores/WebPlayer/WebClientManager.h
@@ -226,6 +226,7 @@ private:
   void ConfigureView(const std::string& profile);
   bool ConfigureViewFromAddon(const std::string& profile);
   std::string UplinkOf(const std::string& profile) const;
+  void SendSoftwareVideoDecoding(const std::string& profile);
   void SendProfileFiles(const std::string& profile,
                         const std::string& path,
                         const std::string& extension,
--- a/xbmc/platform/linux/waylandhost/WaylandHost.cpp
+++ b/xbmc/platform/linux/waylandhost/WaylandHost.cpp
@@ -52,7 +52,7 @@ constexpr uint32_t XDG_WM_BASE_VERSION =
 constexpr uint32_t LINUX_DMABUF_VERSION = 4;
 constexpr uint32_t PRESENTATION_VERSION = 1;
 constexpr uint32_t TEXT_INPUT_VERSION = 1;
-constexpr uint32_t WEB_MANAGER_VERSION = 3;
+constexpr uint32_t WEB_MANAGER_VERSION = 4;
 // kodi_web_manager_v1: a profile identifier is 1 to 255 bytes
 constexpr size_t WEB_PROFILE_MAX = 255;
 // a client blocked in teardown, e.g. on a stale network mount, is killed after this
@@ -1642,6 +1642,18 @@ void CWaylandHost::WebViewSetViewport(st
       });
 }
 
+void CWaylandHost::WebViewSetSoftwareVideoDecoding(std::string profile, bool allowed)
+{
+  Post(
+      [this, profile = std::move(profile), allowed]()
+      {
+        auto* view = FindWebView(profile);
+        if (view && wl_resource_get_version(view->resource) >=
+                        KODI_WEB_VIEW_V1_SET_SOFTWARE_VIDEO_DECODING_SINCE_VERSION)
+          kodi_web_view_v1_send_set_software_video_decoding(view->resource, allowed ? 1 : 0);
+      });
+}
+
 void CWaylandHost::WebViewAddUserScript(std::string profile,
                                         std::string name,
                                         int fd,
--- a/xbmc/platform/linux/waylandhost/WaylandHost.h
+++ b/xbmc/platform/linux/waylandhost/WaylandHost.h
@@ -199,6 +199,7 @@ public:
   void WebViewClose(std::string profile);
   void WebViewSetUserAgent(std::string profile, std::string userAgent);
   void WebViewSetViewport(std::string profile, uint32_t width, uint32_t height);
+  void WebViewSetSoftwareVideoDecoding(std::string profile, bool allowed);
 
   /*!
    * \brief Replace the text around the cursor of the enabled text input;
--- a/xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml
+++ b/xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml
@@ -55,7 +55,7 @@
     the protocol and interface names and resetting the interface version.
   </description>
 
-  <interface name="kodi_web_manager_v1" version="3">
+  <interface name="kodi_web_manager_v1" version="4">
     <description summary="create and announce web views">
       The global through which the browser announces itself and creates
       views. A browser binds it once.
@@ -187,7 +187,7 @@
     </request>
   </interface>
 
-  <interface name="kodi_web_view_v1" version="3">
+  <interface name="kodi_web_view_v1" version="4">
     <description summary="one web view of one profile">
       A view is one page container bound to one surface. The compositor
       drives it with events and learns its state through requests.
@@ -418,5 +418,18 @@
       <arg name="width" type="uint" summary="viewport width in CSS pixels"/>
       <arg name="height" type="uint" summary="viewport height in CSS pixels"/>
     </event>
+
+    <event name="set_software_video_decoding" since="4">
+      <description summary="whether pages may play video decoded in software">
+        Whether the view's pages may play video that the browser decodes
+        in software. Without it, the browser offers pages only the video
+        codecs it decodes in hardware, so that a page choosing among
+        several codecs picks one of those. Video that a content decryption
+        module decrypts and decodes itself is not affected. Takes effect
+        from the next navigation. A view configured without it plays
+        video decoded in hardware only.
+      </description>
+      <arg name="allowed" type="uint" summary="1 to allow software video decoding"/>
+    </event>
   </interface>
 </protocol>
