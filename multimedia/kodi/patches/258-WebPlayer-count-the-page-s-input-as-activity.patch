From bef9799569254be5c9d24ef53ab2c2bef71b7580 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Mon, 9 Nov 2026 14:06:47 +0000
Subject: [PATCH] WebPlayer: count the page's input as activity

Keys and mouse buttons the page takes never reach CInputManager, which
resets the idle timers and wakes the display for every other input. The
display therefore switched off while the remote was in use in a web app,
and keys pressed while it was off went to the page without waking it.

Input for the page resets the idle timers first, and a key or button
that wakes the display does nothing else, as in CInputManager::OnKey().
Pointer motion reaches the page only while the display is awake, so
that Kodi alone decides whether motion wakes it.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/cores/WebPlayer/WebPlayer.cpp | 38 ++++++++++++++++++++++++++----
 xbmc/cores/WebPlayer/WebPlayer.h   |  3 +++
 2 files changed, 37 insertions(+), 4 deletions(-)

--- a/xbmc/cores/WebPlayer/WebPlayer.cpp
+++ b/xbmc/cores/WebPlayer/WebPlayer.cpp
@@ -16,6 +16,7 @@
 #include "addons/IAddon.h"
 #include "addons/addoninfo/AddonType.h"
 #include "application/ApplicationComponents.h"
+#include "application/ApplicationPowerHandling.h"
 #include "cores/DataCacheCore.h"
 #include "cores/VideoPlayer/Interface/TimingConstants.h"
 #include "cores/VideoPlayer/Process/ProcessInfo.h"
@@ -457,6 +458,25 @@ void CWebPlayer::UpdateInputRouting()
   for (uint32_t scancode : m_pressedKeys)
     m_manager->GetHost()->KeyboardKey(scancode, false);
   m_pressedKeys.clear();
+  m_pressedButtons.clear();
+}
+
+// input the page takes never reaches CInputManager, which counts it as
+// activity and lets it wake the display; true when it woke the display
+bool CWebPlayer::InputWakesDisplay() const
+{
+  const auto appPower =
+      CServiceBroker::GetAppComponents().GetComponent<CApplicationPowerHandling>();
+  appPower->ResetSystemIdleTimer();
+  appPower->ResetScreenSaver();
+  return appPower->WakeUpScreenSaverAndDPMS();
+}
+
+bool CWebPlayer::DisplayAsleep() const
+{
+  const auto appPower =
+      CServiceBroker::GetAppComponents().GetComponent<CApplicationPowerHandling>();
+  return appPower->IsDPMSActive() || appPower->IsInScreenSaver();
 }
 
 bool CWebPlayer::OnKeyboardEvent(const XBMC_keysym& keysym, const CKey& key, bool pressed)
@@ -464,17 +484,23 @@ bool CWebPlayer::OnKeyboardEvent(const X
   if (!m_inputActive || IsKodiKey(keysym, key))
     return false;
 
+  // the key that wakes the display does nothing else, its release included
   if (pressed)
+  {
+    if (InputWakesDisplay())
+      return true;
     m_pressedKeys.insert(keysym.scancode);
-  else
-    m_pressedKeys.erase(keysym.scancode);
+  }
+  else if (m_pressedKeys.erase(keysym.scancode) == 0)
+    return true;
   m_manager->GetHost()->KeyboardKey(keysym.scancode, pressed);
   return true;
 }
 
 bool CWebPlayer::OnPosition(int x, int y)
 {
-  if (!m_inputActive)
+  // whether motion wakes the display is Kodi's decision
+  if (!m_inputActive || DisplayAsleep())
     return false;
 
   // an air mouse lying still keeps reporting the same position
@@ -493,6 +519,10 @@ bool CWebPlayer::OnButtonPress(MOUSE::BU
   if (!m_inputActive)
     return false;
 
+  if (InputWakesDisplay())
+    return true;
+  m_pressedButtons.insert(button);
+
   switch (button)
   {
     case MOUSE::BUTTON_ID::LEFT:
@@ -523,7 +553,7 @@ bool CWebPlayer::OnButtonPress(MOUSE::BU
 
 void CWebPlayer::OnButtonRelease(MOUSE::BUTTON_ID button)
 {
-  if (!m_inputActive)
+  if (!m_inputActive || m_pressedButtons.erase(button) == 0)
     return;
 
   switch (button)
--- a/xbmc/cores/WebPlayer/WebPlayer.h
+++ b/xbmc/cores/WebPlayer/WebPlayer.h
@@ -132,6 +132,8 @@ private:
   void KeepPage(const std::shared_ptr<WAYLANDHOST::CWaylandBuffer>& buffer);
   void UpdateInputRouting();
   void UpdateVisibility();
+  bool InputWakesDisplay() const;
+  bool DisplayAsleep() const;
   void StopFromClient(bool error = false);
   void CheckCdm();
   bool AwaitFilterLists();
@@ -168,6 +170,7 @@ private:
   std::atomic<bool> m_mediaAudio{false};
   bool m_mediaPlaying{false};
   std::set<uint32_t> m_pressedKeys;
+  std::set<MOUSE::BUTTON_ID> m_pressedButtons;
   int m_pointerX{-1};
   int m_pointerY{-1};
 };
