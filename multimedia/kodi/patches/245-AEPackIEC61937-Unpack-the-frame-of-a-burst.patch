From 629216a3f1067eb005870a1ef8964011dd508c19 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 22 Oct 2026 10:12:59 +0100
Subject: [PATCH] [AEPackIEC61937] Unpack the frame of a burst

A source that hands over AC3, E-AC3 or DTS as IEC 61937 bursts, the way
it keeps a constant-rate clock, needs the frames back before they can go
through Kodi's own passthrough path. Add the inverse of the Pack
functions: find the next complete burst, take its length from Pd in the
unit its data type uses, and copy the frame out in bitstream order.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../AudioEngine/Utils/AEPackIEC61937.cpp      | 59 +++++++++++++++++++
 xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h | 13 ++++
 2 files changed, 72 insertions(+)

--- a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
+++ b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.cpp
@@ -233,3 +233,62 @@ int CAEPackIEC61937::PackPause(uint8_t *
 
   return periodsNeeded * periodInBytes;
 }
+
+unsigned int CAEPackIEC61937::Unpack(const uint8_t* data,
+                                     unsigned int size,
+                                     unsigned int* offset,
+                                     uint8_t* frame)
+{
+  unsigned int pos = *offset & ~1u;
+
+  for (; pos + IEC61937_DATA_OFFSET <= size; pos += 2)
+  {
+    uint16_t header[IEC61937_DATA_OFFSET / 2];
+    memcpy(header, data + pos, sizeof(header));
+    if (header[0] != IEC61937_PREAMBLE1 || header[1] != IEC61937_PREAMBLE2)
+      continue;
+
+    unsigned int length;
+    switch (header[2] & 0x1f)
+    {
+      case IEC61937_TYPE_AC3:
+      case IEC61937_TYPE_DTS1:
+      case IEC61937_TYPE_DTS2:
+      case IEC61937_TYPE_DTS3:
+        length = header[3] >> 3;
+        break;
+      case IEC61937_TYPE_EAC3:
+        length = header[3];
+        break;
+      default:
+        pos += IEC61937_DATA_OFFSET - 2;
+        continue;
+    }
+
+    const unsigned int stored = length + (length & 0x1);
+    if (stored > MAX_IEC61937_PACKET - IEC61937_DATA_OFFSET)
+    {
+      pos += IEC61937_DATA_OFFSET - 2;
+      continue;
+    }
+
+    if (pos + IEC61937_DATA_OFFSET + stored > size)
+      break;
+
+#ifdef __BIG_ENDIAN__
+    memcpy(frame, data + pos + IEC61937_DATA_OFFSET, stored);
+#else
+    for (unsigned int i = 0; i < stored; i += 2)
+    {
+      frame[i] = data[pos + IEC61937_DATA_OFFSET + i + 1];
+      frame[i + 1] = data[pos + IEC61937_DATA_OFFSET + i];
+    }
+#endif
+
+    *offset = pos + IEC61937_DATA_OFFSET + stored;
+    return length;
+  }
+
+  *offset = pos;
+  return 0;
+}
--- a/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h
+++ b/xbmc/cores/AudioEngine/Utils/AEPackIEC61937.h
@@ -39,6 +39,19 @@ public:
   static int PackTrueHD(const uint8_t* data, unsigned int size, uint8_t* dest);
   static int PackDTSHD(uint8_t* data, unsigned int size, uint8_t* dest, unsigned int period);
   static int PackPause(uint8_t *dest, unsigned int millis, unsigned int framesize, unsigned int samplerate, unsigned int rep_period, unsigned int encodedRate);
+
+  /*!
+   * \brief Copies the AC3, E-AC3 or DTS frame out of the first complete burst at or after
+   * *offset in a stream of bursts as the Pack functions write them
+   * \param frame receives the frame, room for MAX_IEC61937_PACKET bytes
+   * \return the frame size, 0 while no complete burst is there; *offset moves past the
+   * burst, or to where an incomplete one starts
+   */
+  static unsigned int Unpack(const uint8_t* data,
+                             unsigned int size,
+                             unsigned int* offset,
+                             uint8_t* frame);
+
 private:
 
   static int PackDTS(uint8_t *data, unsigned int size, uint8_t *dest, bool littleEndian,
