From f0dbf55ab352698d9be6d31dbc88158fd0111bc5 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 8 Oct 2026 22:43:11 +0100
Subject: [PATCH] WebPlayer: let the user allow software video decoding in
 pages

A page offering several codecs picks the first one the client reports
as playable, which on a device with hardware decoders for only some of
them may be one decoded in software at a frame rate the device cannot
keep. Add web.softwarecodecs, off by default, and pass it as
KODI_WEBVIEW_SOFTWARE_CODECS so the client can keep pages to the codecs
the hardware decodes unless the user allows software decoding.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../resource.language.en_gb/resources/strings.po   | 14 +++++++++++++-
 system/settings/settings.xml                       | 10 ++++++++++
 xbmc/cores/WebPlayer/WebClientManager.cpp          |  4 +++-
 xbmc/settings/Settings.h                           |  1 +
 4 files changed, 27 insertions(+), 2 deletions(-)

--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25711,7 +25711,19 @@ msgctxt "#40241"
 msgid "Web apps"
 msgstr ""
 
-#empty strings from id 40242 to 40399
+#. Name of the setting that allows software video decoding in web pages
+#: system/settings/settings.xml
+msgctxt "#40242"
+msgid "Software video decoding in web pages"
+msgstr ""
+
+#. Help for setting Software video decoding in web pages
+#: system/settings/settings.xml
+msgctxt "#40243"
+msgid "Let web pages use video codecs this device can only decode in software. Off keeps pages to the codecs the hardware decodes, so a page offering several picks one of those."
+msgstr ""
+
+#empty strings from id 40244 to 40399
 
 # Video versions
 
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -2909,6 +2909,16 @@
           </dependencies>
           <control type="toggle" />
         </setting>
+        <setting id="web.softwarecodecs" type="boolean" parent="web.enabled" label="40242" help="40243">
+          <level>1</level>
+          <default>false</default>
+          <dependencies>
+            <dependency type="enable">
+              <condition setting="web.enabled" operator="is">true</condition>
+            </dependency>
+          </dependencies>
+          <control type="toggle" />
+        </setting>
         <setting id="web.clientcommand" type="string" label="40235" help="40236">
           <level>2</level>
           <default>kodi-webview</default>
--- a/xbmc/cores/WebPlayer/WebClientManager.cpp
+++ b/xbmc/cores/WebPlayer/WebClientManager.cpp
@@ -152,7 +152,9 @@ void CWebClientManager::Spawn()
   std::map<std::string, std::string> env{
       {"WPE_PLATFORM", "wayland"},
       {"XDG_DATA_HOME", CSpecialProtocol::TranslatePath("special://profile/webdata")},
-      {"XDG_CACHE_HOME", CSpecialProtocol::TranslatePath("special://temp/webcache")}};
+      {"XDG_CACHE_HOME", CSpecialProtocol::TranslatePath("special://temp/webcache")},
+      {"KODI_WEBVIEW_SOFTWARE_CODECS",
+       settings->GetBool(CSettings::SETTING_WEB_SOFTWARECODECS) ? "1" : "0"}};
   m_host->SpawnClient({command}, std::move(env));
 }
 
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -340,6 +340,7 @@ public:
   static constexpr auto SETTING_WEATHER_ADDONSETTINGS = "weather.addonsettings";
   static constexpr auto SETTING_WEB_ENABLED = "web.enabled";
   static constexpr auto SETTING_WEB_PRELOAD = "web.preload";
+  static constexpr auto SETTING_WEB_SOFTWARECODECS = "web.softwarecodecs";
   static constexpr auto SETTING_WEB_CLIENTCOMMAND = "web.clientcommand";
   static constexpr auto SETTING_SERVICES_DEVICENAME = "services.devicename";
   static constexpr auto SETTING_SERVICES_DEVICEUUID = "services.deviceuuid";
