From d2a2d1c5accddfa8befda891d5d0b065561197e0 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 8 Oct 2026 14:49:56 +0100
Subject: [PATCH] cmake: look for wayland-server, wayland-scanner and the
 protocols

Hosting Wayland clients needs libwayland-server, the wayland-scanner code
generator and the wayland-protocols XML files. Add a find module that
resolves all three into the WaylandServer target and defines
HAVE_WAYLAND_SERVER for the code that uses it, and offer it as an
optional dependency on the GBM and Wayland platforms.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 cmake/modules/FindWaylandServer.cmake | 59 +++++++++++++++++++++++++++
 cmake/platform/linux/gbm.cmake        |  2 +-
 cmake/platform/linux/wayland.cmake    |  2 +-
 3 files changed, 61 insertions(+), 2 deletions(-)
 create mode 100644 cmake/modules/FindWaylandServer.cmake

--- /dev/null
+++ b/cmake/modules/FindWaylandServer.cmake
@@ -0,0 +1,59 @@
+#.rst:
+# FindWaylandServer
+# -----------------
+# Finds the wayland-server library, the wayland-scanner code generator and
+# the wayland-protocols XML files needed to host Wayland clients
+#
+# This will define the following target:
+#
+#   ${APP_NAME_LC}::WaylandServer   - The wayland-server library
+#
+# and the following variables:
+#
+#   WAYLAND_SCANNER_EXECUTABLE   - wayland-scanner program
+#   WAYLAND_PROTOCOLS_DIR        - directory containing the wayland-protocols XML files
+
+if(NOT TARGET ${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME})
+
+  include(cmake/scripts/common/ModuleHelpers.cmake)
+
+  set(${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC wayland-server)
+  set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE_LC}_DISABLE_VERSION ON)
+
+  SETUP_BUILD_VARS()
+
+  SETUP_FIND_SPECS()
+
+  SEARCH_EXISTING_PACKAGES()
+
+  if(${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME}_FOUND)
+    find_package(PkgConfig ${SEARCH_QUIET})
+
+    pkg_check_modules(PC_WAYLAND_SCANNER wayland-scanner ${SEARCH_QUIET})
+    if(PC_WAYLAND_SCANNER_FOUND)
+      pkg_get_variable(PC_WAYLAND_SCANNER_EXECUTABLE wayland-scanner wayland_scanner)
+    endif()
+    find_program(WAYLAND_SCANNER_EXECUTABLE NAMES wayland-scanner
+                                            HINTS ${PC_WAYLAND_SCANNER_EXECUTABLE})
+
+    pkg_check_modules(PC_WAYLAND_PROTOCOLS wayland-protocols ${SEARCH_QUIET})
+    if(PC_WAYLAND_PROTOCOLS_FOUND)
+      pkg_get_variable(WAYLAND_PROTOCOLS_DIR wayland-protocols pkgdatadir)
+    endif()
+    set(WAYLAND_PROTOCOLS_DIR ${WAYLAND_PROTOCOLS_DIR} CACHE INTERNAL "")
+
+    if(WAYLAND_SCANNER_EXECUTABLE AND WAYLAND_PROTOCOLS_DIR)
+      add_library(${APP_NAME_LC}::${CMAKE_FIND_PACKAGE_NAME} ALIAS PkgConfig::${${CMAKE_FIND_PACKAGE_NAME}_SEARCH_NAME})
+
+      set(${${CMAKE_FIND_PACKAGE_NAME}_MODULE}_COMPILE_DEFINITIONS HAVE_WAYLAND_SERVER)
+
+      ADD_TARGET_COMPILE_DEFINITION()
+    elseif(WaylandServer_FIND_REQUIRED)
+      message(FATAL_ERROR "wayland-scanner or wayland-protocols were not found.")
+    endif()
+  else()
+    if(WaylandServer_FIND_REQUIRED)
+      message(FATAL_ERROR "wayland-server library was not found.")
+    endif()
+  endif()
+endif()
--- a/cmake/platform/linux/gbm.cmake
+++ b/cmake/platform/linux/gbm.cmake
@@ -1,5 +1,5 @@
 list(APPEND PLATFORM_REQUIRED_DEPS GBM LibDRM>=2.4.95 LibInput Xkbcommon UDEV LibDisplayInfo)
-list(APPEND PLATFORM_OPTIONAL_DEPS VAAPI)
+list(APPEND PLATFORM_OPTIONAL_DEPS VAAPI WaylandServer)
 
 if(APP_RENDER_SYSTEM STREQUAL "gl")
   list(APPEND PLATFORM_REQUIRED_DEPS OpenGl EGL)
--- a/cmake/platform/linux/wayland.cmake
+++ b/cmake/platform/linux/wayland.cmake
@@ -1,5 +1,5 @@
 list(APPEND PLATFORM_REQUIRED_DEPS WaylandProtocols>=1.7 Waylandpp>=0.2.2 LibDRM>=2.4.95 Xkbcommon>=0.4.1)
-list(APPEND PLATFORM_OPTIONAL_DEPS VAAPI)
+list(APPEND PLATFORM_OPTIONAL_DEPS VAAPI WaylandServer)
 
 if(APP_RENDER_SYSTEM STREQUAL "gl")
   list(APPEND PLATFORM_REQUIRED_DEPS OpenGl EGL)
