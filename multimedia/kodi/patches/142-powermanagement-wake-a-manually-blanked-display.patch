From 7f99f86757e1e5802911422eec66ad55f4d146f7 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sat, 19 Sep 2026 19:04:38 +0100
Subject: [PATCH] [powermanagement] optionally wake a manually blanked display

A display switched off from the power menu stays off whatever arrives:
WakeUpScreenSaverAndDPMS() returns early when the blank was manual, so
the only way back is the power menu. On a device driven entirely by a
remote that is a trap, and on one with no keyboard at all there is no
obvious way out.

Add powermanagement.wakemanualdpms, off by default, which leaves today's
behaviour alone. With it on, input wakes the display again.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../resource.language.en_gb/resources/strings.po   | 14 ++++++++++++--
 system/settings/settings.xml                       |  5 +++++
 xbmc/application/ApplicationPowerHandling.cpp      |  6 ++++--
 xbmc/settings/Settings.h                           |  1 +
 4 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index 45bc746556..d54f3d209c 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -8587,7 +8587,12 @@ msgctxt "#14128"
 msgid "Allow double refresh rates"
 msgstr ""
 
-#empty strings from id 14129 to 14186
+#: system/settings/settings.xml
+msgctxt "#14129"
+msgid "Wake a manually switched off display on input"
+msgstr ""
+
+#empty strings from id 14130 to 14186
 
 #: system/settings/settings.xml
 msgctxt "#14187"
@@ -20469,7 +20474,12 @@ msgctxt "#36193"
 msgid "This category contains the settings for how DVD's, Blu-ray, & CD's are handled."
 msgstr ""
 
-#empty strings from id 36194
+#. Description of setting with label #14129 "Wake a manually switched off display on input"
+msgctxt "#36194"
+msgid "Let input wake a display that was switched off from the power menu. When disabled, only switching the display back on from the power menu wakes it."
+msgstr ""
+
+#empty strings from id 36195
 
 #. Description of setting with label #21372 "Forced DVD player region"
 #: system/settings/settings.xml
diff --git a/system/settings/settings.xml b/system/settings/settings.xml
index 3ab8d2129c..8330675ed6 100755
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3756,6 +3756,11 @@
             <formatlabel>14044</formatlabel>
           </control>
         </setting>
+        <setting id="powermanagement.wakemanualdpms" type="boolean" label="14129" help="36194">
+          <level>2</level>
+          <default>false</default>
+          <control type="toggle" />
+        </setting>
         <setting id="powermanagement.restartplayer" type="boolean" label="1451" help="36416">
           <level>1</level>
           <default>true</default>
diff --git a/xbmc/application/ApplicationPowerHandling.cpp b/xbmc/application/ApplicationPowerHandling.cpp
index 3b9c2e080a..46da6b27ea 100644
--- a/xbmc/application/ApplicationPowerHandling.cpp
+++ b/xbmc/application/ApplicationPowerHandling.cpp
@@ -119,11 +119,13 @@ bool CApplicationPowerHandling::WakeUpScreenSaverAndDPMS(bool bPowerOffKeyPresse
   // First reset DPMS, if active
   if (m_dpmsIsActive)
   {
-    if (m_dpmsIsManual)
+    if (m_dpmsIsManual && !CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+                              CSettings::SETTING_POWERMANAGEMENT_WAKEMANUALDPMS))
       return false;
+
     //! @todo if screensaver lock is specified but screensaver is not active
     //! (DPMS came first), activate screensaver now.
-    ToggleDPMS(false);
+    ToggleDPMS(m_dpmsIsManual);
     ResetScreenSaverTimer();
     result = !m_screensaverActive || WakeUpScreenSaver(bPowerOffKeyPressed);
   }
diff --git a/xbmc/settings/Settings.h b/xbmc/settings/Settings.h
index c33a458aef..3c40405510 100644
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -446,6 +446,7 @@ public:
   static constexpr auto SETTING_NETWORK_HTTPPROXYPASSWORD = "network.httpproxypassword";
   static constexpr auto SETTING_NETWORK_BANDWIDTH = "network.bandwidth";
   static constexpr auto SETTING_POWERMANAGEMENT_DISPLAYSOFF = "powermanagement.displaysoff";
+  static constexpr auto SETTING_POWERMANAGEMENT_WAKEMANUALDPMS = "powermanagement.wakemanualdpms";
   static constexpr auto SETTING_POWERMANAGEMENT_SHUTDOWNTIME = "powermanagement.shutdowntime";
   static constexpr auto SETTING_POWERMANAGEMENT_SHUTDOWNSTATE = "powermanagement.shutdownstate";
   static constexpr auto SETTING_POWERMANAGEMENT_WAKEONACCESS = "powermanagement.wakeonaccess";
