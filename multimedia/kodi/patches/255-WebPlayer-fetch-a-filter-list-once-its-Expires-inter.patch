From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 5 Nov 2026 19:37:06 +0000
Subject: [PATCH] WebPlayer: fetch a filter list once its Expires interval is
 over

EasyList and EasyPrivacy publish a new generation about every hour,
so the check at every start and every six hours fetched a newer list
almost every time, and the web client spent minutes compiling it.
The lists state how often they are to be updated, as "! Expires:
4 days" in their header. That interval is stored with the Date the
server sent the list with, and a newer generation is fetched only
once the server's Date in the next check is that far ahead. Both
times are the server's, so a local clock that is not set yet does
not shorten or extend the interval. A list without the header line
is fetched whenever a newer generation is published.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/cores/WebPlayer/WebFilterLists.cpp | 67 +++++++++++++++++++++++--
 xbmc/cores/WebPlayer/WebFilterLists.h   |  4 +-
 2 files changed, 65 insertions(+), 6 deletions(-)

--- a/xbmc/cores/WebPlayer/WebFilterLists.cpp
+++ b/xbmc/cores/WebPlayer/WebFilterLists.cpp
@@ -12,6 +12,7 @@
 #include "FileItemList.h"
 #include "ServiceBroker.h"
 #include "URL.h"
+#include "XBDateTime.h"
 #include "filesystem/CurlFile.h"
 #include "filesystem/Directory.h"
 #include "filesystem/File.h"
@@ -27,6 +28,7 @@
 #include <chrono>
 #include <limits>
 #include <mutex>
+#include <sstream>
 #include <vector>
 
 #include <poll.h>
@@ -58,6 +60,50 @@ bool SameGeneration(const CHttpHeader& h
   return !publishedModified.empty() && publishedModified == modified;
 }
 
+int64_t ListExpiresSeconds(const std::string& list)
+{
+  std::istringstream lines(list);
+  std::string line;
+  std::getline(lines, line);
+  if (!StringUtils::StartsWith(line, "["))
+    lines.seekg(0);
+  while (std::getline(lines, line) && StringUtils::StartsWith(line, "!"))
+  {
+    std::string field = line.substr(1);
+    StringUtils::Trim(field);
+    if (!StringUtils::StartsWithNoCase(field, "Expires:"))
+      continue;
+
+    const std::vector<std::string> words = StringUtils::Split(field.substr(8), ' ', 3);
+    std::vector<std::string> value;
+    for (const auto& word : words)
+      if (!word.empty())
+        value.push_back(word);
+    if (value.size() < 2)
+      return 0;
+
+    const int64_t count = std::atoll(value[0].c_str());
+    if (StringUtils::StartsWithNoCase(value[1], "day"))
+      return count * 24 * 60 * 60;
+    if (StringUtils::StartsWithNoCase(value[1], "hour"))
+      return count * 60 * 60;
+    return 0;
+  }
+  return 0;
+}
+
+// both times come from the server, as the local clock may not be set yet
+bool Expired(const CHttpHeader& published, const std::string& fetched, const std::string& expires)
+{
+  const int64_t seconds = std::atoll(expires.c_str());
+  const CDateTime now = CDateTime::FromRFC1123DateTime(published.GetValue("date"));
+  const CDateTime then = CDateTime::FromRFC1123DateTime(fetched);
+  if (seconds <= 0 || !now.IsValid() || !then.IsValid())
+    return true;
+
+  return (now - then).GetSecondsTotal() >= seconds;
+}
+
 bool WriteFile(const std::string& path, const std::string& data)
 {
   const std::string temp = path + ".new";
@@ -256,11 +302,18 @@ CWebFilterLists::Result CWebFilterLists:
   if (meta.size() >= 3 && meta[0] == url && XFILE::CFile::Exists(path, false))
   {
     CHttpHeader published;
-    if (XFILE::CCurlFile::GetHttpHeader(CURL(url), published) &&
-        SameGeneration(published, meta[1], meta[2]))
+    if (XFILE::CCurlFile::GetHttpHeader(CURL(url), published))
     {
-      CLog::Log(LOGINFO, "CWebFilterLists::{}: {} is unchanged", __FUNCTION__, name);
-      return Result::UNCHANGED;
+      if (SameGeneration(published, meta[1], meta[2]))
+      {
+        CLog::Log(LOGINFO, "CWebFilterLists::{}: {} is unchanged", __FUNCTION__, name);
+        return Result::UNCHANGED;
+      }
+      if (meta.size() >= 5 && !Expired(published, meta[3], meta[4]))
+      {
+        CLog::Log(LOGINFO, "CWebFilterLists::{}: {} has not expired", __FUNCTION__, name);
+        return Result::UNCHANGED;
+      }
     }
 
     if (!meta[1].empty())
@@ -291,6 +344,7 @@ CWebFilterLists::Result CWebFilterLists:
     list.append(buffer, read);
   const std::string etag = http.GetHttpHeader().GetValue("etag");
   const std::string modified = http.GetHttpHeader().GetValue("last-modified");
+  const std::string fetched = http.GetHttpHeader().GetValue("date");
   http.Close();
 
   if (status != 200 || read < 0 || list.empty())
@@ -301,7 +355,10 @@ CWebFilterLists::Result CWebFilterLists:
     return Result::FAILED;
   }
 
-  if (!WriteFile(path, list) || !WriteFile(metaPath, url + "\n" + etag + "\n" + modified + "\n"))
+  const std::string expires = std::to_string(ListExpiresSeconds(list));
+  const std::string stored =
+      StringUtils::Join(std::vector<std::string>{url, etag, modified, fetched, expires, ""}, "\n");
+  if (!WriteFile(path, list) || !WriteFile(metaPath, stored))
   {
     CLog::Log(LOGERROR, "CWebFilterLists::{}: {} cannot be stored in {}", __FUNCTION__, name,
               m_dir);
--- a/xbmc/cores/WebPlayer/WebFilterLists.h
+++ b/xbmc/cores/WebPlayer/WebFilterLists.h
@@ -31,7 +31,9 @@ namespace WEB
  * apps name are fetched in the background when Kodi starts, a list named
  * later when a web app first asks for it. Every six hours a HEAD request
  * compares each list's published ETag or Last-Modified date with the stored
- * one, and only a newer list is fetched. The client is handed each list once
+ * one, and a newer list is fetched once the stored one is older than the
+ * interval its "Expires" header line states, measured between the server's
+ * Date headers. The client is handed each list once
  * a run, and again when its content changes; a failed fetch is retried early
  * when the system clock is set.
  */
