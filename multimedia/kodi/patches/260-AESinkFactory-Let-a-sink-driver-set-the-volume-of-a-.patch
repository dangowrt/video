From 0d41dd0a959f3e49905820edaefd6f9aab80b56d Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 9 Oct 2026 20:14:06 +0100
Subject: [PATCH] [AESinkFactory] Let a sink driver set the volume of a device

Kodi reaches a volume control only through an open sink, and the engine
closes its sink once Kodi's own audio has been silent for a while. A
volume that belongs to the output device, and so to every program
playing on it, then stays out of reach while only other programs play.

Add optional HasDeviceVolume and SetDeviceVolume functions to a sink
driver's registration entry, and CAESinkFactory calls that reach them by
device name, independent of any open sink.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/cores/AudioEngine/AESinkFactory.cpp | 16 ++++++++++++++++
 xbmc/cores/AudioEngine/AESinkFactory.h   |  6 ++++++
 2 files changed, 22 insertions(+)

--- a/xbmc/cores/AudioEngine/AESinkFactory.cpp
+++ b/xbmc/cores/AudioEngine/AESinkFactory.cpp
@@ -129,3 +129,19 @@ void CAESinkFactory::Cleanup()
       reg.second.cleanupFunc();
   }
 }
+
+bool CAESinkFactory::HasDeviceVolume(const std::string& device)
+{
+  const AESinkDevice dev = ParseDevice(device);
+  const auto reg = m_AESinkRegEntry.find(dev.driver);
+  return reg != m_AESinkRegEntry.end() && reg->second.hasDeviceVolumeFunc &&
+         reg->second.hasDeviceVolumeFunc(dev.name);
+}
+
+bool CAESinkFactory::SetDeviceVolume(const std::string& device, float volume, bool mute)
+{
+  const AESinkDevice dev = ParseDevice(device);
+  const auto reg = m_AESinkRegEntry.find(dev.driver);
+  return reg != m_AESinkRegEntry.end() && reg->second.setDeviceVolumeFunc &&
+         reg->second.setDeviceVolumeFunc(dev.name, volume, mute);
+}
--- a/xbmc/cores/AudioEngine/AESinkFactory.h
+++ b/xbmc/cores/AudioEngine/AESinkFactory.h
@@ -33,6 +33,8 @@ using CreateSink =
     std::function<std::unique_ptr<IAESink>(std::string& device, AEAudioFormat& desiredFormat)>;
 using Enumerate = std::function<void(AEDeviceInfoList& list, bool force)>;
 using Cleanup = std::function<void()>;
+using HasDeviceVolume = std::function<bool(const std::string& device)>;
+using SetDeviceVolume = std::function<bool(const std::string& device, float volume, bool mute)>;
 
 struct AESinkRegEntry
 {
@@ -40,6 +42,8 @@ struct AESinkRegEntry
   CreateSink createFunc;
   Enumerate enumerateFunc;
   Cleanup cleanupFunc;
+  HasDeviceVolume hasDeviceVolumeFunc;
+  SetDeviceVolume setDeviceVolumeFunc;
 };
 
 struct AESinkDevice
@@ -65,6 +69,8 @@ public:
   static std::unique_ptr<IAESink> Create(std::string& device, AEAudioFormat& desiredFormat);
   static void EnumerateEx(std::vector<AESinkInfo>& list, bool force, const std::string& driver);
   static void Cleanup();
+  static bool HasDeviceVolume(const std::string& device);
+  static bool SetDeviceVolume(const std::string& device, float volume, bool mute);
 
 protected:
   static std::map<std::string, AESinkRegEntry> m_AESinkRegEntry;
