From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Mon, 2 Nov 2026 10:52:48 +1000
Subject: [PATCH] Don't deadlock when playback is stopped during the refresh
 rate switch

With "Adjust display refresh rate" on, CVideoPlayer::OpenVideoStream()
switches the display mode with a blocking TMSG_SETVIDEORESOLUTION to the
app thread. If the app thread handles a stop first, it goes into
CloseFile(), which waits in StopThread() for the VideoPlayer thread, and
neither thread gets any further. On playback start the app thread sits
in CGUIDialogBusy::WaitOnEvent() for 100 ms without handling messages,
so a stop in those 100 ms is queued ahead of the switch, and Kodi hangs
whenever the stream opens fast enough to reach the switch in that time.

The VideoPlayer thread now sends the switch with SendMsgAbortable() and
gives up when StopThread() sets the thread's stop event, which CThread
now makes available to subclasses. A switch the app thread hasn't
started yet is dropped, so the display isn't left in the video mode
with nothing playing. OpenVideoStream() and OpenStream() then return
early instead of opening codecs for a player that is closing.

Assisted-by: Claude
(cherry picked from commit 0e096d7601078e2d5fccdb2c853ee6bf89275885)
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 12 ++++++++++--
 xbmc/threads/Thread.h                  |  3 +++
 xbmc/windowing/GraphicContext.cpp      |  7 ++++++-
 xbmc/windowing/GraphicContext.h        |  9 ++++++++-
 4 files changed, 27 insertions(+), 4 deletions(-)

--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -4223,6 +4223,10 @@ bool CVideoPlayer::OpenStream(CCurrentSt
   CDemuxStream* stream = NULL;
   CDVDStreamInfo hint;
 
+  // CloseFile() is waiting for this thread
+  if (m_bStop)
+    return false;
+
   CLog::Log(LOGINFO, "Opening stream: {} source: {}", iStream, source);
 
   if(STREAM_SOURCE_MASK(source) == STREAM_SOURCE_DEMUX_SUB)
@@ -4363,7 +4367,7 @@ bool CVideoPlayer::OpenStream(CCurrentSt
   }
   else
   {
-    if(stream)
+    if (stream && !m_bStop)
     {
       /* mark stream as disabled, to disallow further attempts*/
       CLog::Log(LOGWARNING, "{} - Unsupported stream {}. Stream disabled.", __FUNCTION__,
@@ -4479,7 +4483,11 @@ bool CVideoPlayer::OpenVideoStream(CDVDS
                                                    (hint.fpsrate * (hint.interlaced ? 2 : 1)));
 
       RESOLUTION res = CResolutionUtils::ChooseBestResolution(static_cast<float>(framerate), hint.width, hint.height, !hint.stereo_mode.empty());
-      CServiceBroker::GetWinSystem()->GetGfxContext().SetVideoResolution(res, false);
+      // CloseFile() blocks the app thread in StopThread(), don't wait for it past that
+      CServiceBroker::GetWinSystem()->GetGfxContext().SetVideoResolution(res, false,
+                                                                         &GetStopEvent());
+      if (m_bStop)
+        return false;
       m_renderManager.TriggerUpdateResolution(framerate, hint.width, hint.height, hint.stereo_mode);
     }
   }
--- a/xbmc/threads/Thread.h
+++ b/xbmc/threads/Thread.h
@@ -108,6 +108,9 @@ protected:
 
   std::atomic<bool> m_bStop;
 
+  //! Set by StopThread(), i.e. once the owner may be blocked waiting for this thread
+  CEvent& GetStopEvent() { return m_StopEvent; }
+
   enum WaitResponse { WAIT_INTERRUPTED = -1, WAIT_SIGNALED = 0, WAIT_TIMEDOUT = 1 };
 
   /**
--- a/xbmc/windowing/GraphicContext.cpp
+++ b/xbmc/windowing/GraphicContext.cpp
@@ -385,12 +385,17 @@ bool CGraphicContext::IsValidResolution(
 }
 
 // call SetVideoResolutionInternal and ensure its done from mainthread
-void CGraphicContext::SetVideoResolution(RESOLUTION res, bool forceUpdate)
+void CGraphicContext::SetVideoResolution(RESOLUTION res, bool forceUpdate, CEvent* abortEvent)
 {
   if (CServiceBroker::GetAppMessenger()->IsProcessThread())
   {
     SetVideoResolutionInternal(res, forceUpdate);
   }
+  else if (abortEvent)
+  {
+    CServiceBroker::GetAppMessenger()->SendMsgAbortable(TMSG_SETVIDEORESOLUTION, res,
+                                                        forceUpdate ? 1 : 0, nullptr, *abortEvent);
+  }
   else
   {
     CServiceBroker::GetAppMessenger()->SendMsg(TMSG_SETVIDEORESOLUTION, res, forceUpdate ? 1 : 0);
--- a/xbmc/windowing/GraphicContext.h
+++ b/xbmc/windowing/GraphicContext.h
@@ -59,6 +59,8 @@ enum RENDER_ORDER
   RENDER_ORDER_FRONT_TO_BACK,
 };
 
+class CEvent;
+
 class CGraphicContext : public CCriticalSection
 {
 public:
@@ -74,7 +76,12 @@ public:
   void SetFullScreenVideo(bool bOnOff);
   bool IsFullScreenVideo() const;
   bool IsValidResolution(RESOLUTION res);
-  void SetVideoResolution(RESOLUTION res, bool forceUpdate);
+  /*!
+   * \brief Switch the video resolution on the app thread
+   * \param abortEvent off the app thread, stop waiting once set, and drop the switch if the app
+   *        thread hasn't started it yet
+   */
+  void SetVideoResolution(RESOLUTION res, bool forceUpdate, CEvent* abortEvent = nullptr);
   void ApplyModeChange(RESOLUTION res);
   void ApplyWindowResize(int newWidth, int newHeight);
   RESOLUTION GetVideoResolution() const;
