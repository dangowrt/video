From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Tue, 10 Nov 2026 14:11:03 +0000
Subject: [PATCH] GBM: drop the stale fences from a replayed atomic request

The request DrmAtomicCommit() falls back to still carries the
IN_FENCE_FD and OUT_FENCE_PTR of the frame it was committed with. That
in-fence was closed after its commit, so the kernel rejects the replay
with EINVAL, or the number now belongs to another file. A replay of an
asynchronous GUI flip therefore never succeeds.

Remove both properties from the replayed request and give it the fences
of the frame it now shows, as the regular request gets them.

Fixes: e9710033029d ("CDRMAtomic: add support for using DRM_MODE_ATOMIC_NONBLOCK")
Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/windowing/gbm/drm/DRMAtomic.cpp | 41 ++++++++++++++++++++++++----
 xbmc/windowing/gbm/drm/DRMAtomic.h   |  2 ++
 2 files changed, 37 insertions(+), 6 deletions(-)

--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -106,12 +106,7 @@ void CDRMAtomic::DrmAtomicCommit(int fb_
     AddProperty(outputPlane, "CRTC_Y", 0);
     AddProperty(outputPlane, "CRTC_W", m_mode->hdisplay);
     AddProperty(outputPlane, "CRTC_H", m_mode->vdisplay);
-
-    if (m_inFenceFd != -1)
-    {
-      AddProperty(m_crtc, "OUT_FENCE_PTR", reinterpret_cast<uint64_t>(&m_outFenceFd));
-      AddProperty(outputPlane, "IN_FENCE_FD", m_inFenceFd);
-    }
+    AddFences(outputPlane);
   }
   //! @todo Reaching out to the window manager and application player
   //! singletons from inside the DRM layer is a layering violation. The
@@ -145,7 +140,10 @@ void CDRMAtomic::DrmAtomicCommit(int fb_
 
     // update the old atomic request with the new fb id to avoid tearing
     if (ret == 0 && rendered)
+    {
       AddProperty(outputPlane, "FB_ID", fb_id);
+      AddFences(outputPlane);
+    }
   }
 
   if (ret == 0)
@@ -193,9 +191,22 @@ bool CDRMAtomic::UseLastRequest()
 
   m_atomicRequestQueue.pop_back();
   m_req = lastRequest;
+
+  // the fences of the frame it was committed with are closed by now
+  m_req->RemoveProperty("IN_FENCE_FD");
+  m_req->RemoveProperty("OUT_FENCE_PTR");
   return true;
 }
 
+void CDRMAtomic::AddFences(CDRMPlane* plane)
+{
+  if (m_inFenceFd == -1)
+    return;
+
+  AddProperty(m_crtc, "OUT_FENCE_PTR", reinterpret_cast<uint64_t>(&m_outFenceFd));
+  AddProperty(plane, "IN_FENCE_FD", m_inFenceFd);
+}
+
 void CDRMAtomic::FlipPage(struct gbm_bo* bo, bool rendered, bool videoLayer, bool async)
 {
   struct drm_fb* drm_fb = nullptr;
@@ -352,6 +363,24 @@ bool CDRMAtomic::CDRMAtomicRequest::AddP
   return true;
 }
 
+void CDRMAtomic::CDRMAtomicRequest::RemoveProperty(const char* name)
+{
+  bool removed = false;
+  for (auto& [object, properties] : m_atomicRequestItems)
+    removed |= properties.erase(object->GetPropertyId(name)) > 0;
+
+  if (!removed)
+    return;
+
+  // a libdrm request only grows, so it is built again from what is left
+  m_atomicRequest.reset(drmModeAtomicAlloc());
+  for (const auto& [object, properties] : m_atomicRequestItems)
+  {
+    for (const auto& [propertyId, value] : properties)
+      drmModeAtomicAddProperty(m_atomicRequest.get(), object->GetId(), propertyId, value);
+  }
+}
+
 void CDRMAtomic::CDRMAtomicRequest::CacheProperties()
 {
   for (const auto& [object, properties] : m_atomicRequestItems)
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -43,6 +43,7 @@ public:
 private:
   void DrmAtomicCommit(int fb_id, int flags, bool rendered, bool videoLayer);
   bool UseLastRequest();
+  void AddFences(CDRMPlane* plane);
 
   bool m_need_modeset{true};
   bool m_active = true;
@@ -57,6 +58,7 @@ private:
     drmModeAtomicReqPtr Get() const { return m_atomicRequest.get(); }
 
     bool AddProperty(CDRMObject* object, const char* name, uint64_t value);
+    void RemoveProperty(const char* name);
     void CacheProperties();
     void LogAtomicRequest();
 
