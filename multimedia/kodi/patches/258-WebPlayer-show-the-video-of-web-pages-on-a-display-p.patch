+void CWebPlayer::ShowPicture(VideoPicture& picture)
+{
+  auto* buffer = static_cast<CVideoBufferDRMPRIME*>(picture.videoBuffer);
+  const AVDRMFrameDescriptor* descriptor = buffer->GetDescriptor();
