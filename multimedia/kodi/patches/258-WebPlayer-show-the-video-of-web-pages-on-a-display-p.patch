+// the last page stays locked, to be shown again when its video leaves the video plane
+void CWebPlayer::KeepPage(const std::shared_ptr<CWaylandBuffer>& buffer)
+{
+  if (m_page)
+    m_page->Unlock();
+  buffer->Lock();
+  m_page = buffer;
