+                          public WAYLANDHOST::IWaylandHostObserver,
+                          public IRenderLoop,
+                          public IDispResource
+{
+public:
+  enum class State
+  {
+    ABSENT,
+    STARTING,
+    READY,
+    FAILED,
+  };
+
+  struct ViewState
+  {
+    std::string profile;
+    std::string url;
