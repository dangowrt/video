From 35b66b391cd794ded9548686465fe0298f0653ed Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sun, 1 Nov 2026 12:00:12 +0000
Subject: [PATCH] WebPlayer: let a web app use the host's content filter lists

A host may keep maintained ad and tracker lists compiled for every web
engine on it, such as EasyList kept up to date by a system service. A
web app now opts into such a list with <contentfilter list="..."/>,
and Kodi passes the list's name to the web client with the new
add_content_filter_list event of kodi_web_view_v1 version 2. A client
bound at version 1 does not get it, and Kodi logs that the list is not
applied.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/cores/WebPlayer/WebClientManager.cpp     | 14 ++++++++----
 .../linux/waylandhost/WaylandHost.cpp         | 21 +++++++++++++++++-
 xbmc/platform/linux/waylandhost/WaylandHost.h |  5 +++++
 .../waylandhost/protocol/kodi-web-v1.xml      | 22 ++++++++++++++-----
 4 files changed, 52 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/WebPlayer/WebClientManager.cpp b/xbmc/cores/WebPlayer/WebClientManager.cpp
index 67b5443356..a2538dc4d5 100644
--- a/xbmc/cores/WebPlayer/WebClientManager.cpp
+++ b/xbmc/cores/WebPlayer/WebClientManager.cpp
@@ -490,10 +490,16 @@ bool CWebClientManager::ConfigureViewFromAddon(const std::string& profile)
           URIUtils::AddFileToFolder(webapp->Path(), values.GetValue("userscript").asString()),
           true);
     else if (element == "contentfilter")
-      SendProfileFile(
-          profile,
-          URIUtils::AddFileToFolder(webapp->Path(), values.GetValue("contentfilter").asString()),
-          false);
+    {
+      const std::string list = values.GetValue("contentfilter@list").asString();
+      if (!list.empty())
+        m_host->WebViewAddContentFilterList(profile, list);
+      else
+        SendProfileFile(
+            profile,
+            URIUtils::AddFileToFolder(webapp->Path(), values.GetValue("contentfilter").asString()),
+            false);
+    }
   }
   return true;
 }
diff --git a/xbmc/platform/linux/waylandhost/WaylandHost.cpp b/xbmc/platform/linux/waylandhost/WaylandHost.cpp
index 07b0e22f47..3b5aaacf96 100644
--- a/xbmc/platform/linux/waylandhost/WaylandHost.cpp
+++ b/xbmc/platform/linux/waylandhost/WaylandHost.cpp
@@ -50,7 +50,7 @@ constexpr uint32_t XDG_WM_BASE_VERSION = 1;
 constexpr uint32_t LINUX_DMABUF_VERSION = 4;
 constexpr uint32_t PRESENTATION_VERSION = 1;
 constexpr uint32_t TEXT_INPUT_VERSION = 1;
-constexpr uint32_t WEB_MANAGER_VERSION = 1;
+constexpr uint32_t WEB_MANAGER_VERSION = 2;
 
 // evdev key codes map to xkb key codes with this offset (xkbcommon convention)
 constexpr uint32_t XKB_KEYCODE_OFFSET = 8;
@@ -1517,6 +1517,25 @@ void CWaylandHost::WebViewAddContentFilter(std::string profile,
        { SendWebViewFile(profile, name, fd, size, false); });
 }
 
+void CWaylandHost::WebViewAddContentFilterList(std::string profile, std::string name)
+{
+  Post(
+      [this, profile = std::move(profile), name = std::move(name)]()
+      {
+        auto* view = FindWebView(profile);
+        if (!view)
+          return;
+        if (wl_resource_get_version(view->resource) <
+            KODI_WEB_VIEW_V1_ADD_CONTENT_FILTER_LIST_SINCE_VERSION)
+        {
+          CLog::Log(LOGWARNING,
+                    "CWaylandHost::WebViewAddContentFilterList: the browser cannot apply {}", name);
+          return;
+        }
+        kodi_web_view_v1_send_add_content_filter_list(view->resource, name.c_str());
+      });
+}
+
 void CWaylandHost::SendWebViewFile(
     const std::string& profile, const std::string& name, int fd, uint32_t size, bool script)
 {
diff --git a/xbmc/platform/linux/waylandhost/WaylandHost.h b/xbmc/platform/linux/waylandhost/WaylandHost.h
index 60dfe869f7..7e5f12201d 100644
--- a/xbmc/platform/linux/waylandhost/WaylandHost.h
+++ b/xbmc/platform/linux/waylandhost/WaylandHost.h
@@ -187,6 +187,11 @@ public:
   void WebViewAddUserScript(std::string profile, std::string name, int fd, uint32_t size);
   void WebViewAddContentFilter(std::string profile, std::string name, int fd, uint32_t size);
 
+  /*!
+   * \brief Apply a content filter list the system keeps compiled; any thread
+   */
+  void WebViewAddContentFilterList(std::string profile, std::string name);
+
   struct WebView
   {
     CWaylandHost* host{nullptr};
diff --git a/xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml b/xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml
index ed1daaf360..4f8aa5e6d7 100644
--- a/xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml
+++ b/xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml
@@ -50,7 +50,7 @@
     the protocol and interface names and resetting the interface version.
   </description>
 
-  <interface name="kodi_web_manager_v1" version="1">
+  <interface name="kodi_web_manager_v1" version="2">
     <description summary="create and announce web views">
       The global through which the browser announces itself and creates
       views. A browser binds it once.
@@ -85,8 +85,8 @@
 
         The profile names the hermetic storage this view uses. The
         compositor configures the view with set_user_agent,
-        add_user_script and add_content_filter events before its first
-        load_url, so the browser must not load anything into a fresh view
+        add_user_script, add_content_filter and add_content_filter_list
+        events before its first load_url, so the browser must not load anything into a fresh view
         on its own.
       </description>
       <arg name="id" type="new_id" interface="kodi_web_view_v1"/>
@@ -134,13 +134,13 @@
     </request>
   </interface>
 
-  <interface name="kodi_web_view_v1" version="1">
+  <interface name="kodi_web_view_v1" version="2">
     <description summary="one web view of one profile">
       A view is one page container bound to one surface. The compositor
       drives it with events and learns its state through requests.
 
       Configuration events (set_user_agent, add_user_script,
-      add_content_filter) apply to this view only and take effect from
+      add_content_filter, add_content_filter_list) apply to this view only and take effect from
       the next navigation. They arrive before the first load_url of a
       view the compositor asked for.
 
@@ -302,5 +302,17 @@
         view. The profile's storage stays.
       </description>
     </event>
+
+    <event name="add_content_filter_list" since="2">
+      <description summary="apply a system content filter list to this view">
+        A request filter the system keeps compiled for every web engine on
+        the host, named by its list identifier, such as a maintained ad or
+        tracker list. Where the browser finds those lists is its own
+        configuration. A list that is not there yet, or that is replaced
+        later, is applied to this view once it appears; a list the system
+        removes is removed from the view.
+      </description>
+      <arg name="name" type="string" summary="list identifier"/>
+    </event>
   </interface>
 </protocol>
-- 
