 cmake/modules/FindUplinkDNS.cmake  | 29 +++++++++++++++
 xbmc/network/DNSNameCache.cpp      | 15 +++++++-
 xbmc/network/UplinkAddress.cpp     | 57 ++++++++++++++++++++++++++++--
 xbmc/network/UplinkAddress.h       |  2 ++
 xbmc/settings/AdvancedSettings.cpp |  8 +++++
 6 files changed, 109 insertions(+), 3 deletions(-)
 create mode 100644 cmake/modules/FindUplinkDNS.cmake

