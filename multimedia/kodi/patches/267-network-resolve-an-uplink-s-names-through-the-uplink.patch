 namespace
 {
+int SystemLookup(const char* host, const addrinfo* hints, addrinfo** res)
+{
+#if defined(HAS_UPLINKDNS)
+  return uplinkdns_getaddrinfo(UPLINKDNS_CTX_SYSTEM, host, nullptr, hints, res);
+#else
+  return getaddrinfo(host, nullptr, hints, res);
+#endif
+}
+
 bool IsUnusableIPv4Address(uint32_t address)
 {
   address = ntohl(address);
@@ -128,7 +141,7 @@ bool CDNSNameCache::Lookup(const std::st
   hints.ai_socktype = SOCK_STREAM;
   hints.ai_flags |= AI_CANONNAME;
 
-  if (getaddrinfo(strHostName.c_str(), nullptr, &hints, &res) == 0)
+  if (SystemLookup(strHostName.c_str(), &hints, &res) == 0)
   {
     strIpAddress = KODI::NETWORK::SelectDNSAddress(res);
     freeaddrinfo(res);
--- a/xbmc/network/UplinkAddress.cpp
+++ b/xbmc/network/UplinkAddress.cpp
@@ -19,10 +19,15 @@
 #include <arpa/inet.h>
 #include <ifaddrs.h>
 #include <net/if.h>
+#include <netdb.h>
 #include <netinet/in.h>
 #include <sys/socket.h>
 #endif
 
+#if defined(HAS_UPLINKDNS)
+#include <uplinkdns.h>
+#endif
+
 namespace KODI::NETWORK
 {
 
@@ -116,17 +121,61 @@ std::string PrefixAddress(const std::str
 
   return FirstAddress(prefixFamily, {}, &network, static_cast<unsigned int>(bits));
 }
+
+bool SyntheticName(const std::string& host, std::string& name)
+{
+#if defined(HAS_UPLINKDNS)
+  sockaddr_in6 sin6 = {};
+  sockaddr_in sin = {};
+  char text[NI_MAXHOST] = {};
+  int ret = -1;
+
+  if (inet_pton(AF_INET, host.c_str(), &sin.sin_addr) == 1)
+  {
+    sin.sin_family = AF_INET;
+    ret = uplinkdns_name_get(reinterpret_cast<sockaddr*>(&sin), sizeof(sin), text, sizeof(text));
+  }
+  else if (inet_pton(AF_INET6, host.c_str(), &sin6.sin6_addr) == 1)
+  {
+    sin6.sin6_family = AF_INET6;
+    ret = uplinkdns_name_get(reinterpret_cast<sockaddr*>(&sin6), sizeof(sin6), text, sizeof(text));
+  }
+
+  if (ret != 0)
+    return false;
+
+  name = text;
+  return true;
+#else
+  return false;
+#endif
+}
 #endif
 } // unnamed namespace
 
+std::string UplinkKey(const std::string& spec)
+{
+  return spec.substr(0, spec.find(';'));
+}
+
+void RegisterUplink(const std::string& spec)
+{
+#if defined(HAS_UPLINKDNS)
+  if (!spec.empty() && uplinkdns_uplink_add(spec.c_str()) < 0)
+    CLog::LogF(LOGERROR, "invalid uplink specification '{}'", spec);
+#endif
+}
+
 UplinkBinding ResolveUplink(const std::string& spec, int family)
 {
   UplinkBinding binding;
-  const std::string& key = spec;
+  const std::string key = UplinkKey(spec);
 
   if (key.empty())
     return binding;
 
+  RegisterUplink(spec);
+
 #if !defined(TARGET_POSIX)
   binding.address = key;
 #else
@@ -164,7 +213,7 @@ UplinkBinding RequireUplink(const std::s
 
   // no device carries the key of an unavailable uplink, so binding to it fails the request
   if (!binding.IsValid())
-    binding.device = spec;
+    binding.device = UplinkKey(spec);
 
   return binding;
 }
@@ -187,6 +236,10 @@ bool IsDirectDestination(const std::stri
     return true;
 
 #if defined(TARGET_POSIX)
+  std::string name;
+  if (SyntheticName(host, name))
+    return name.find('.') == std::string::npos;
+
   in6_addr address6 = {};
   if (inet_pton(AF_INET6, host.c_str(), &address6) == 1)
     return IN6_IS_ADDR_LOOPBACK(&address6) || IN6_IS_ADDR_LINKLOCAL(&address6) ||
