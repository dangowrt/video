From 13168cbc3068c2c8c65922c574fd6bc751ffce61 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 22 Oct 2026 09:04:09 +0100
Subject: [PATCH] WebPlayer: bind a web app's view to its uplink

A host with more than one uplink needs some web apps to leave through
a particular one, a broadcaster's app through a tunnel to its country
while the others use the local line. A web add-on's uplinkaddress
setting, an address, a subnet or an interface name, is handed to the
client with want_view, which binds every connection of the view's
session to it. The session is created with the uplink, so a view whose
add-on now names another one is closed and asked for again.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/cores/WebPlayer/WebClientManager.cpp | 41 ++++++++++++++++++++---
 xbmc/cores/WebPlayer/WebClientManager.h   |  4 +++
 2 files changed, 41 insertions(+), 4 deletions(-)

--- a/xbmc/cores/WebPlayer/WebClientManager.cpp
+++ b/xbmc/cores/WebPlayer/WebClientManager.cpp
@@ -126,6 +126,7 @@ void CWebClientManager::Stop()
   m_state = State::ABSENT;
   m_views.clear();
   m_surfaces.clear();
+  m_replacing.clear();
   m_observer = nullptr;
 }
 
@@ -193,6 +194,8 @@ bool CWebClientManager::RequestView(cons
   if (!m_host)
     return false;
 
+  const std::string uplink = UplinkOf(profile);
+
   std::unique_lock lock(m_lock);
   m_observer = &observer;
   m_observedProfile = profile;
@@ -201,7 +204,7 @@ bool CWebClientManager::RequestView(cons
   m_wantPending = false;
 
   const auto view = m_views.find(profile);
-  if (view != m_views.end() && view->second)
+  if (view != m_views.end() && view->second && m_uplinks[profile] == uplink)
   {
     CWaylandSurface& surface = *view->second;
     lock.unlock();
@@ -209,10 +212,24 @@ bool CWebClientManager::RequestView(cons
     return true;
   }
 
+  m_uplinks[profile] = uplink;
+  if (m_replacing.count(profile))
+    return true;
+
+  // the uplink is fixed when the client creates the view's session
+  if (view != m_views.end())
+  {
+    m_replacing.insert(profile);
+    m_surfaces.erase(view->second);
+    m_views.erase(view);
+    m_host->WebViewClose(profile);
+    return true;
+  }
+
   switch (m_state)
   {
     case State::READY:
-      m_host->WebWantView(profile, {});
+      m_host->WebWantView(profile, uplink);
       break;
     case State::STARTING:
       m_wantPending = true;
@@ -312,6 +329,7 @@ void CWebClientManager::OnClientExited(p
             __FUNCTION__, pid, status);
   m_views.clear();
   m_surfaces.clear();
+  m_replacing.clear();
   IWebViewObserver* observer = m_observer;
   const std::string profile = m_observedProfile;
 
@@ -342,9 +360,20 @@ void CWebClientManager::OnWebClientReady
   const bool want = m_wantPending && m_views.find(m_observedProfile) == m_views.end();
   m_wantPending = false;
   const std::string profile = m_observedProfile;
+  const std::string uplink = m_uplinks[profile];
   lock.unlock();
   if (want)
-    m_host->WebWantView(profile, {});
+    m_host->WebWantView(profile, uplink);
+}
+
+std::string CWebClientManager::UplinkOf(const std::string& profile) const
+{
+  ADDON::AddonPtr addon;
+  if (!CServiceBroker::GetAddonMgr().GetAddon(profile, addon, ADDON::AddonType::WEBAPP,
+                                              ADDON::OnlyEnabled::CHOICE_YES))
+    return {};
+
+  return addon->GetSetting("uplinkaddress");
 }
 
 bool CWebClientManager::ConfigureViewFromAddon(const std::string& profile)
@@ -539,9 +568,13 @@ void CWebClientManager::OnWebViewDestroy
     m_surfaces.erase(view->second);
     m_views.erase(view);
   }
+  const bool replaced = m_replacing.erase(profile) > 0;
   IWebViewObserver* observer = ObserverOf(profile);
+  const std::string uplink = m_uplinks[profile];
   lock.unlock();
-  if (observer)
+  if (replaced && observer)
+    m_host->WebWantView(profile, uplink);
+  else if (observer)
     observer->OnWebViewGone(profile);
 }
 
--- a/xbmc/cores/WebPlayer/WebClientManager.h
+++ b/xbmc/cores/WebPlayer/WebClientManager.h
@@ -17,6 +17,7 @@
 
 #include <map>
 #include <memory>
+#include <set>
 #include <string>
 
 namespace KODI
@@ -140,6 +141,7 @@ private:
   void Spawn();
   void ConfigureView(const std::string& profile);
   bool ConfigureViewFromAddon(const std::string& profile);
+  std::string UplinkOf(const std::string& profile) const;
   void SendProfileFiles(const std::string& profile,
                         const std::string& path,
                         const std::string& extension,
@@ -158,6 +160,8 @@ private:
   bool m_wantPending{false};
   std::map<std::string, WAYLANDHOST::CWaylandSurface*> m_views;
   std::map<WAYLANDHOST::CWaylandSurface*, std::string> m_surfaces;
+  std::map<std::string, std::string> m_uplinks;
+  std::set<std::string> m_replacing;
   bool m_keyboardOpen{false};
   bool m_textInputActive{false};
   WAYLANDHOST::TextInputState m_textInput;
