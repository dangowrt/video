From 5c4dfc8cec28cca8b7eaf96b0d7b59e3cc5ae60f Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 8 Oct 2026 14:12:25 +0100
Subject: [PATCH] [posix] Use the standard names of the 64-bit file interfaces

musl 1.2.4 removed the LFS64 aliases such as stat64, fstat64, lseek64,
fseeko64, statvfs64 and off64_t, as off_t is 64 bits wide on every
musl target. Use the standard names, which are 64-bit on glibc too,
since Kodi builds with _FILE_OFFSET_BITS=64 on Linux.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 xbmc/cores/DllLoader/exports/emu_msvcrt.cpp  | 12 ++++++------
 xbmc/guilib/XBTFReader.cpp                   |  2 +-
 xbmc/platform/posix/Filesystem.cpp           |  4 ++--
 xbmc/platform/posix/PlatformDefs.h           |  2 +-
 xbmc/platform/posix/XHandle.h                |  2 +-
 xbmc/platform/posix/filesystem/PosixFile.cpp | 12 ++++++------
 6 files changed, 17 insertions(+), 17 deletions(-)

--- a/xbmc/cores/DllLoader/exports/emu_msvcrt.cpp
+++ b/xbmc/cores/DllLoader/exports/emu_msvcrt.cpp
@@ -638,7 +638,7 @@ extern "C"
 #if defined(TARGET_WINDOWS)
       return _fstat64(fd, buf);
 #else
-      return fstat64(fd, buf);
+      return fstat(fd, buf);
 #endif
     CLog::Log(LOGERROR, "{} emulated function failed", __FUNCTION__);
     return -1;
@@ -1236,7 +1236,7 @@ extern "C"
     return EOF;
   }
 
-  int dll_fseek64(FILE* stream, off64_t offset, int origin)
+  int dll_fseek64(FILE* stream, off_t offset, int origin)
   {
     int fd = g_emuFileWrapper.GetDescriptorByStream(stream);
     if (fd >= 0)
@@ -1289,12 +1289,12 @@ extern "C"
     return (long)dll_ftell64(stream);
   }
 
-  off64_t dll_ftell64(FILE *stream)
+  off_t dll_ftell64(FILE *stream)
   {
     CFile* pFile = g_emuFileWrapper.GetFileXbmcByStream(stream);
     if (pFile != NULL)
     {
-       return (off64_t)pFile->GetPosition();
+       return (off_t)pFile->GetPosition();
     }
     CLog::Log(LOGERROR, "{} emulated function failed", __FUNCTION__);
     return -1;
@@ -1339,7 +1339,7 @@ extern "C"
 #elif defined(TARGET_DARWIN) || defined(TARGET_FREEBSD) || defined(TARGET_ANDROID)
       return lseek(fd, 0, SEEK_CUR);
 #else
-      return lseek64(fd, 0, SEEK_CUR);
+      return lseek(fd, 0, SEEK_CUR);
 #endif
     }
     CLog::Log(LOGERROR, "{} emulated function failed", __FUNCTION__);
@@ -1563,7 +1563,7 @@ extern "C"
 #elif defined(TARGET_WASM) || !defined(__GLIBC__)
       tmpPos = *pos;
 #else
-      tmpPos.__pos = (off64_t)(pos->__pos);
+      tmpPos.__pos = (off_t)(pos->__pos);
 #endif
       return dll_fsetpos64(stream, &tmpPos);
     }
--- a/xbmc/guilib/XBTFReader.cpp
+++ b/xbmc/guilib/XBTFReader.cpp
@@ -216,7 +216,7 @@ bool CXBTFReader::Load(const CXBTFFrame&
 #elif defined(TARGET_ANDROID)
   if (fseek(m_file, static_cast<long>(frame.GetOffset()), SEEK_SET) == -1)  // No fseeko64 before N
 #else
-  if (fseeko64(m_file, static_cast<off_t>(frame.GetOffset()), SEEK_SET) == -1)
+  if (fseeko(m_file, static_cast<off_t>(frame.GetOffset()), SEEK_SET) == -1)
 #endif
     return false;
 
--- a/xbmc/platform/posix/Filesystem.cpp
+++ b/xbmc/platform/posix/Filesystem.cpp
@@ -37,8 +37,8 @@ space_info space(const std::string& path
   ec.clear();
   space_info sp;
 #if defined(TARGET_LINUX) || defined(TARGET_WASM)
-  struct statvfs64 fsInfo;
-  auto result = statvfs64(CSpecialProtocol::TranslatePath(path).c_str(), &fsInfo);
+  struct statvfs fsInfo;
+  auto result = statvfs(CSpecialProtocol::TranslatePath(path).c_str(), &fsInfo);
 #else
   struct statfs fsInfo;
   // is 64-bit on android and darwin (10.6SDK + any iOS)
--- a/xbmc/platform/posix/PlatformDefs.h
+++ b/xbmc/platform/posix/PlatformDefs.h
@@ -114,7 +114,7 @@ typedef int (*LPTHREAD_START_ROUTINE)(vo
     #define statfs64 statfs
   #endif
 #else
-  #define __stat64 stat64
+  #define __stat64 stat
 #endif
 
 struct _stati64 {
--- a/xbmc/platform/posix/XHandle.h
+++ b/xbmc/platform/posix/XHandle.h
@@ -44,7 +44,7 @@ public:
   std::vector<std::string> m_FindFileResults;
   int              m_nFindFileIterator;
   std::string      m_FindFileDir;
-  off64_t          m_iOffset;
+  off_t          m_iOffset;
   bool             m_bCDROM;
   bool             m_bEventSet;
   int              m_nRefCount;
--- a/xbmc/platform/posix/filesystem/PosixFile.cpp
+++ b/xbmc/platform/posix/filesystem/PosixFile.cpp
@@ -211,8 +211,8 @@ int64_t CPosixFile::GetLength()
   if (m_fd < 0)
     return -1;
 
-  struct stat64 st;
-  if (fstat64(m_fd, &st) != 0)
+  struct stat st;
+  if (fstat(m_fd, &st) != 0)
     return -1;
 
   return st.st_size;
@@ -327,8 +327,8 @@ bool CPosixFile::Exists(const CURL& url)
   if (filename.empty())
     return false;
 
-  struct stat64 st;
-  return stat64(filename.c_str(), &st) == 0 && !S_ISDIR(st.st_mode);
+  struct stat st;
+  return stat(filename.c_str(), &st) == 0 && !S_ISDIR(st.st_mode);
 }
 
 int CPosixFile::Stat(const CURL& url, struct __stat64* buffer)
@@ -374,7 +374,7 @@ int CPosixFile::Stat(const CURL& url, st
   }
   return ret;
 #else
-  return stat64(filename.c_str(), buffer);
+  return stat(filename.c_str(), buffer);
 #endif
 }
 
@@ -384,5 +384,5 @@ int CPosixFile::Stat(struct __stat64* bu
   if (m_fd < 0 || !buffer)
     return -1;
 
-  return fstat64(m_fd, buffer);
+  return fstat(m_fd, buffer);
 }
