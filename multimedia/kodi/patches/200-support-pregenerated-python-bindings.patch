swig: allow pre-generated Python bindings

Upstream generates the Python API bindings at build time with SWIG and a
Groovy code generator, which needs a JRE plus three archive downloads
during cmake configure. With PYTHON_BINDINGS_DIR set, use bindings that
were generated ahead of time instead (see README.md), keeping Java and
network access out of the build.

--- a/xbmc/interfaces/swig/CMakeLists.txt
+++ b/xbmc/interfaces/swig/CMakeLists.txt
@@ -1,4 +1,16 @@
 function(generate_file file)
+  # Use bindings generated ahead of time (see PYTHON_BINDINGS_DIR) instead of
+  # running SWIG and the Groovy code generator, which would require a JRE and
+  # network downloads at build time.
+  if(PYTHON_BINDINGS_DIR)
+    set(CPP_FILE ${file}.cpp)
+    add_custom_command(OUTPUT ${CPP_FILE}
+                       COMMAND ${CMAKE_COMMAND} -E copy ${PYTHON_BINDINGS_DIR}/${CPP_FILE} ${CPP_FILE}
+                       DEPENDS ${PYTHON_BINDINGS_DIR}/${CPP_FILE})
+    set(SOURCES ${SOURCES} "${CPP_FILE}" PARENT_SCOPE)
+    return()
+  endif()
+
   set(classpath ${groovy_SOURCE_DIR}/lib/*
                 ${apache-commons-lang_SOURCE_DIR}/*
                 ${apache-commons-text_SOURCE_DIR}/*
@@ -54,6 +66,7 @@
   set(SOURCES ${SOURCES} "${CPP_FILE}" PARENT_SCOPE)
 endfunction()
 
+if(NOT PYTHON_BINDINGS_DIR)
 find_package(Java COMPONENTS Runtime REQUIRED ${SEARCH_QUIET})
 find_package(SWIG REQUIRED ${SEARCH_QUIET})
 
@@ -145,6 +158,7 @@
 
   set(apache-commons-text_SOURCE_DIR ${DEPENDS_PATH}/share/java/text)
 endif()
+endif()
 
 # The generated bindings
 set(INPUTS AddonModuleXbmcaddon.i
