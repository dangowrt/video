From 375c4c3af69ac6a576b6a8119369fc175d1f8bb5 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sun, 18 Oct 2026 22:29:09 +0100
Subject: [PATCH] VideoBufferDMA: handle a factory with no buffer object

CBufferObjectFactory::CreateBufferObject() returns nullptr when none of
the registered buffer objects can allocate by size. CBufferObject's
create-by-size form defaults to false, so only the dma-heap and udmabuf
backends satisfy it, and each declines to register when its device node
is absent. A system left with just the dumb and GBM backends therefore
constructs CVideoBufferDMA with a null m_bo, and Alloc() calls through
it, taking the process down with SIGSEGV inside the decoder's frame
thread on the first software-decoded frame.

Check m_bo in Alloc(), and in Destroy() too, which the destructor
reaches when CVideoBufferPoolDMA::Get() discards a buffer whose Alloc()
failed. CVideoBufferPoolDMA::Released() already treats the factory
result as nullable, and the buffer now does the same.
---
 .../VideoPlayer/Buffers/VideoBufferDMA.cpp    | 14 ++++++--
 .../Buffers/test/TestVideoBufferDMA.cpp       | 36 +++++++++++++++++++
 2 files changed, 48 insertions(+), 2 deletions(-)

--- a/xbmc/cores/VideoPlayer/Buffers/VideoBufferDMA.cpp
+++ b/xbmc/cores/VideoPlayer/Buffers/VideoBufferDMA.cpp
@@ -106,6 +106,13 @@ void CVideoBufferDMA::SetDimensions(int
 
 bool CVideoBufferDMA::Alloc()
 {
+  if (!m_bo)
+  {
+    CLog::Log(LOGERROR, "CVideoBufferDMA::{} - no buffer object able to allocate by size",
+              __FUNCTION__);
+    return false;
+  }
+
   if (!m_bo->CreateBufferObject(m_size))
     return false;
 
@@ -177,8 +184,11 @@ void CVideoBufferDMA::SyncEnd()
 
 void CVideoBufferDMA::Destroy()
 {
-  m_bo->ReleaseMemory();
-  m_bo->DestroyBufferObject();
+  if (m_bo)
+  {
+    m_bo->ReleaseMemory();
+    m_bo->DestroyBufferObject();
+  }
 
   for (auto& offset : m_offsets)
     offset = 0;
--- a/xbmc/cores/VideoPlayer/Buffers/test/TestVideoBufferDMA.cpp
+++ b/xbmc/cores/VideoPlayer/Buffers/test/TestVideoBufferDMA.cpp
@@ -51,6 +51,20 @@ private:
   std::unique_ptr<uint8_t[]> m_memory;
 };
 
+// mirrors CDumbBufferObject and CGBMBufferObject, which only allocate by format
+class FormatOnlyBufferObject : public CBufferObject
+{
+public:
+  bool CreateBufferObject(uint32_t format, uint32_t width, uint32_t height) override
+  {
+    return true;
+  }
+  void DestroyBufferObject() override {}
+  uint8_t* GetMemory() override { return nullptr; }
+  void ReleaseMemory() override {}
+  std::string GetName() const override { return "FormatOnlyBufferObject"; }
+};
+
 struct CountingStat
 {
   std::map<int, uint64_t> inodes;
@@ -81,6 +95,13 @@ protected:
   void TearDown() override { CBufferObjectFactory::ClearBufferObjects(); }
 };
 
+class TestVideoBufferDMANoBackend : public ::testing::Test
+{
+protected:
+  void SetUp() override { CBufferObjectFactory::ClearBufferObjects(); }
+  void TearDown() override { CBufferObjectFactory::ClearBufferObjects(); }
+};
+
 } // namespace
 
 // identity is derived fresh from the descriptor; layout changes must land in it
@@ -125,3 +146,18 @@ TEST_F(TestVideoBufferDMA, IsValidGateSu
   buffer->SetDimensions(1920, 1080, strides, offsets);
   EXPECT_TRUE(buffer->IsValid());
 }
+
+TEST_F(TestVideoBufferDMANoBackend, AllocFailsWithNothingRegistered)
+{
+  auto buffer = std::make_unique<CVideoBufferDMA>(0, FOURCC_NV12, 2, 1920 * 1080 * 3 / 2);
+  EXPECT_FALSE(buffer->Alloc());
+}
+
+TEST_F(TestVideoBufferDMANoBackend, AllocFailsWhenNoBackendAllocatesBySize)
+{
+  CBufferObjectFactory::RegisterBufferObject(
+      [] { return std::make_unique<FormatOnlyBufferObject>(); });
+
+  auto buffer = std::make_unique<CVideoBufferDMA>(0, FOURCC_NV12, 2, 1920 * 1080 * 3 / 2);
+  EXPECT_FALSE(buffer->Alloc());
+}
