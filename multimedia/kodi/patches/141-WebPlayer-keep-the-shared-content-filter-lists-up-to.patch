+    UNKNOWN,
+    FETCHING,
+    FETCH_FAILED,
+    PREPARING,
+    PREPARED,
+    PREPARE_FAILED,
+  };
+
+  /*!
+   * \brief changed is set whenever a list's state changes
+   */
+  CWebFilterLists(WAYLANDHOST::CWaylandHost& host, CEvent& changed);
