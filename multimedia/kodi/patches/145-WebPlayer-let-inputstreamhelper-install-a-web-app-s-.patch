 // the client destroys the view later; a request for the profile waits for that
@@ -929,7 +954,12 @@ void CWebClientManager::OnClientExited(p
   {
     m_restarting = false;
     m_state = State::ABSENT;
-    m_wantPending = false;
+    if (m_wantPending)
+    {
