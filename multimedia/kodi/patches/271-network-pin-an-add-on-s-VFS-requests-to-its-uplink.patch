 xbmc/filesystem/PluginDirectory.cpp      | 12 ++-----
 xbmc/interfaces/legacy/File.h            |  7 +++--
 xbmc/interfaces/legacy/ModuleXbmcvfs.cpp | 40 ++++++++++++++++++------
 xbmc/interfaces/legacy/Stat.h            |  5 ++-
 xbmc/network/UplinkAddress.cpp           | 34 ++++++++++++++++++++
 xbmc/network/UplinkAddress.h             |  3 ++
 7 files changed, 79 insertions(+), 23 deletions(-)

