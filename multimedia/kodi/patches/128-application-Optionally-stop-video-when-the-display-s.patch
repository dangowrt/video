From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Mon, 9 Nov 2026 13:24:36 +0000
Subject: [PATCH] [application] Optionally stop video when the display switches
 off

A box that powers down along with its display has to end video
playback first, and the only way a client has is Player.Stop. That
request wakes the display it is meant to follow: TMSG_MEDIA_STOP calls
WakeUpScreenSaverAndDPMS() before stopping, so a client stopping video
on OnDPMSActivated switches the display straight back on.

Add powermanagement.dpmsstopsvideo, off by default. With it on,
ToggleDPMS() stops video playback itself once the display is off and
before OnDPMSActivated goes out; music keeps playing.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../resources/strings.po                        | 17 +++++++++++++++--
 system/settings/settings.xml                    |  5 +++++
 xbmc/application/ApplicationPowerHandling.cpp   | 16 ++++++++++++++++
 xbmc/application/ApplicationPowerHandling.h     |  1 +
 xbmc/settings/Settings.h                        |  1 +
 5 files changed, 38 insertions(+), 2 deletions(-)

--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -8609,7 +8609,12 @@ msgctxt "#14130"
 msgid "Pointer motion wakes the display"
 msgstr ""
 
-#empty strings from id 14131 to 14186
+#: system/settings/settings.xml
+msgctxt "#14131"
+msgid "Stop video when the display switches off"
+msgstr ""
+
+#empty strings from id 14132 to 14186
 
 #: system/settings/settings.xml
 msgctxt "#14187"
@@ -20430,7 +20435,15 @@ msgctxt "#36058"
 msgid "Automatic"
 msgstr ""
 
-#empty strings from id 36059 to 36095
+#empty string with id 36059
+
+#. Description of setting with label #14131 "Stop video when the display switches off"
+#: system/settings/settings.xml
+msgctxt "#36060"
+msgid "Stop video playback when the display switches off, after the idle time or from the power menu, as a television does. Music keeps playing."
+msgstr ""
+
+#empty strings from id 36061 to 36095
 
 #. Label of setting "System / Display / Use system HDR/SDR brightness balance"
 #: system/settings/settings.xml
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3889,6 +3889,11 @@
           <default>false</default>
           <control type="toggle" />
         </setting>
+        <setting id="powermanagement.dpmsstopsvideo" type="boolean" label="14131" help="36060">
+          <level>2</level>
+          <default>false</default>
+          <control type="toggle" />
+        </setting>
         <setting id="powermanagement.restartplayer" type="boolean" label="1451" help="36416">
           <level>1</level>
           <default>true</default>
--- a/xbmc/application/ApplicationPowerHandling.cpp
+++ b/xbmc/application/ApplicationPowerHandling.cpp
@@ -14,6 +14,7 @@
 #include "addons/AddonManager.h"
 #include "addons/addoninfo/AddonType.h"
 #include "addons/gui/GUIDialogAddonSettings.h"
+#include "application/Application.h"
 #include "application/ApplicationComponents.h"
 #include "application/ApplicationPlayer.h"
 #include "guilib/GUIComponent.h"
@@ -75,6 +76,20 @@ void CApplicationPowerHandling::StopScre
   m_screenSaverTimer.Stop();
 }
 
+// a player stop request wakes the display, so stop here directly
+void CApplicationPowerHandling::StopVideoWhileDPMS()
+{
+  const auto& components = CServiceBroker::GetAppComponents();
+  const auto appPlayer = components.GetComponent<CApplicationPlayer>();
+  if (!appPlayer->IsPlayingVideo() ||
+      !CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+          CSettings::SETTING_POWERMANAGEMENT_DPMSSTOPSVIDEO))
+    return;
+
+  CLog::LogF(LOGINFO, "the display switched off, stopping video playback");
+  g_application.StopPlaying();
+}
+
 bool CApplicationPowerHandling::ToggleDPMS(bool manual)
 {
   auto winSystem = CServiceBroker::GetWinSystem();
@@ -104,6 +119,7 @@ bool CApplicationPowerHandling::ToggleDP
         m_dpmsIsManual = manual;
         SetRenderGUI(false);
         CheckOSScreenSaverInhibitionSetting();
+        StopVideoWhileDPMS();
         CServiceBroker::GetAnnouncementManager()->Announce(ANNOUNCEMENT::GUI, "OnDPMSActivated");
         return true;
       }
--- a/xbmc/application/ApplicationPowerHandling.h
+++ b/xbmc/application/ApplicationPowerHandling.h
@@ -74,6 +74,7 @@ protected:
   void InhibitScreenSaver(bool inhibit);
   void ResetScreenSaverTimer();
   bool WakeUpScreenSaver(bool bPowerOffKeyPressed = false);
+  void StopVideoWhileDPMS();
 
   void InhibitIdleShutdown(bool inhibit);
 
--- a/xbmc/settings/Settings.h
+++ b/xbmc/settings/Settings.h
@@ -450,6 +450,7 @@ public:
   static constexpr auto SETTING_NETWORK_BANDWIDTH = "network.bandwidth";
   static constexpr auto SETTING_POWERMANAGEMENT_DISPLAYSOFF = "powermanagement.displaysoff";
   static constexpr auto SETTING_POWERMANAGEMENT_WAKEMANUALDPMS = "powermanagement.wakemanualdpms";
+  static constexpr auto SETTING_POWERMANAGEMENT_DPMSSTOPSVIDEO = "powermanagement.dpmsstopsvideo";
   static constexpr auto SETTING_POWERMANAGEMENT_SHUTDOWNTIME = "powermanagement.shutdowntime";
   static constexpr auto SETTING_POWERMANAGEMENT_SHUTDOWNSTATE = "powermanagement.shutdownstate";
   static constexpr auto SETTING_POWERMANAGEMENT_WAKEONACCESS = "powermanagement.wakeonaccess";
