From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Tue, 10 Nov 2026 14:13:25 +0000
Subject: [PATCH] VideoLayerBridgeDRMPRIME: describe the whole plane with every
 frame

UpdateVideoPlane() sets FB_ID and CRTC_ID alone and leaves the source
and destination rectangles to what SetVideoPlane() set before. When the
request of that SetVideoPlane() failed its test commit, DrmAtomicCommit()
committed an earlier request in its place, so the plane still holds the
rectangles of the previous video, and a smaller frame of the new one is
then refused with ENOSPC.

Keep the destination rectangle and set the source and destination with
every framebuffer.

Fixes: 83a88dfc29c5 ("RendererDRMPRIME: commit current buffer when there is nothing to update")
Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../HwDecRender/VideoLayerBridgeDRMPRIME.cpp  | 26 ++++++++++++-------
 .../HwDecRender/VideoLayerBridgeDRMPRIME.h    |  6 +++++
 2 files changed, 22 insertions(+), 10 deletions(-)

--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.cpp
@@ -219,16 +219,8 @@ void CVideoLayerBridgeDRMPRIME::SetVideo
   if (!PrepareBuffer(buffer))
     return;
 
-  m_DRM->AddProperty(plane, "FB_ID", m_fb_id);
-  m_DRM->AddProperty(plane, "CRTC_ID", m_DRM->GetCrtc()->GetCrtcId());
-  m_DRM->AddProperty(plane, "SRC_X", 0);
-  m_DRM->AddProperty(plane, "SRC_Y", 0);
-  m_DRM->AddProperty(plane, "SRC_W", buffer->GetWidth() << 16);
-  m_DRM->AddProperty(plane, "SRC_H", buffer->GetHeight() << 16);
-  m_DRM->AddProperty(plane, "CRTC_X", static_cast<int32_t>(destRect.x1) & ~1);
-  m_DRM->AddProperty(plane, "CRTC_Y", static_cast<int32_t>(destRect.y1) & ~1);
-  m_DRM->AddProperty(plane, "CRTC_W", (static_cast<uint32_t>(destRect.Width()) + 1) & ~1);
-  m_DRM->AddProperty(plane, "CRTC_H", (static_cast<uint32_t>(destRect.Height()) + 1) & ~1);
+  m_destRect = destRect;
+  AddPlaneProperties(plane);
 }
 
 void CVideoLayerBridgeDRMPRIME::UpdateVideoPlane()
@@ -240,6 +232,20 @@ void CVideoLayerBridgeDRMPRIME::UpdateVi
   if (!plane)
     return;
 
+  AddPlaneProperties(plane);
+}
+
+// the request that last set up the plane may never have reached the kernel
+void CVideoLayerBridgeDRMPRIME::AddPlaneProperties(CDRMPlane* plane)
+{
   m_DRM->AddProperty(plane, "FB_ID", m_fb_id);
   m_DRM->AddProperty(plane, "CRTC_ID", m_DRM->GetCrtc()->GetCrtcId());
+  m_DRM->AddProperty(plane, "SRC_X", 0);
+  m_DRM->AddProperty(plane, "SRC_Y", 0);
+  m_DRM->AddProperty(plane, "SRC_W", m_buffer->GetWidth() << 16);
+  m_DRM->AddProperty(plane, "SRC_H", m_buffer->GetHeight() << 16);
+  m_DRM->AddProperty(plane, "CRTC_X", static_cast<int32_t>(m_destRect.x1) & ~1);
+  m_DRM->AddProperty(plane, "CRTC_Y", static_cast<int32_t>(m_destRect.y1) & ~1);
+  m_DRM->AddProperty(plane, "CRTC_W", (static_cast<uint32_t>(m_destRect.Width()) + 1) & ~1);
+  m_DRM->AddProperty(plane, "CRTC_H", (static_cast<uint32_t>(m_destRect.Height()) + 1) & ~1);
 }
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/VideoLayerBridgeDRMPRIME.h
@@ -10,6 +10,7 @@
 
 #include "cores/VideoPlayer/Buffers/DmaBufIdentityCache.h"
 #include "cores/VideoPlayer/Interface/StreamInfo.h"
+#include "utils/Geometry.h"
 #include "windowing/gbm/VideoLayerBridge.h"
 
 #include <memory>
@@ -23,6 +24,7 @@ namespace WINDOWING
 namespace GBM
 {
 class CDRMAtomic;
+class CDRMPlane;
 }
 } // namespace WINDOWING
 } // namespace KODI
@@ -57,4 +59,8 @@ private:
   CVideoBufferDRMPRIME* m_prev_buffer = nullptr;
   uint32_t m_fb_id{0};
   uint32_t m_prev_fb_id{0};
+
+  void AddPlaneProperties(KODI::WINDOWING::GBM::CDRMPlane* plane);
+
+  CRect m_destRect;
 };
