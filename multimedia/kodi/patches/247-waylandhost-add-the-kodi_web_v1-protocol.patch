From 4ab8f36bc6580c818bf5c2068120188350c44652 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Thu, 8 Oct 2026 20:40:43 +0100
Subject: [PATCH] waylandhost: add the kodi_web_v1 protocol

The host needs a control channel to the web client it spawns: which
page a view shows, which profile it belongs to, when it is in front,
and what the page reports back. kodi_web_v1 carries that as a private
Wayland protocol bound to the view's wl_surface. The browser is the
client, so its reports are requests and Kodi's commands are events;
views are created by the client on Kodi's want_view, one per hermetic
profile; user agent, user scripts and content filters travel per view
as file descriptors, so a sandboxed client needs no path of Kodi's.
want_view also names the uplink, an address, a subnet or an interface,
the profile's connections are bound to, because the browser creates
the profile's session with it. The XML lives in the tree and is
generated like the external protocols.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../platform/linux/waylandhost/CMakeLists.txt |  10 +-
 .../waylandhost/protocol/kodi-web-v1.xml      | 306 ++++++++++++++++++
 2 files changed, 311 insertions(+), 5 deletions(-)
 create mode 100644 xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml

--- a/xbmc/platform/linux/waylandhost/CMakeLists.txt
+++ b/xbmc/platform/linux/waylandhost/CMakeLists.txt
@@ -1,8 +1,9 @@
 if(TARGET ${APP_NAME_LC}::WaylandServer)
-  set(PROTOCOLS linux-dmabuf-v1:stable/linux-dmabuf/linux-dmabuf-v1.xml
-                presentation-time:stable/presentation-time/presentation-time.xml
-                text-input-unstable-v3:unstable/text-input/text-input-unstable-v3.xml
-                xdg-shell:stable/xdg-shell/xdg-shell.xml)
+  set(PROTOCOLS linux-dmabuf-v1:${WAYLAND_PROTOCOLS_DIR}/stable/linux-dmabuf/linux-dmabuf-v1.xml
+                presentation-time:${WAYLAND_PROTOCOLS_DIR}/stable/presentation-time/presentation-time.xml
+                text-input-unstable-v3:${WAYLAND_PROTOCOLS_DIR}/unstable/text-input/text-input-unstable-v3.xml
+                xdg-shell:${WAYLAND_PROTOCOLS_DIR}/stable/xdg-shell/xdg-shell.xml
+                kodi-web-v1:${CMAKE_CURRENT_SOURCE_DIR}/protocol/kodi-web-v1.xml)
 
   set(SOURCES WaylandBuffer.cpp
               WaylandHost.cpp
@@ -16,7 +17,6 @@ if(TARGET ${APP_NAME_LC}::WaylandServer)
     string(REPLACE ":" ";" protocol ${protocol})
     list(GET protocol 0 name)
     list(GET protocol 1 xml)
-    set(xml ${WAYLAND_PROTOCOLS_DIR}/${xml})
     set(header ${CMAKE_CURRENT_BINARY_DIR}/${name}-server-protocol.h)
     set(code ${CMAKE_CURRENT_BINARY_DIR}/${name}-protocol.c)
     add_custom_command(OUTPUT ${header}
--- /dev/null
+++ b/xbmc/platform/linux/waylandhost/protocol/kodi-web-v1.xml
@@ -0,0 +1,306 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="kodi_web_v1">
+
+  <copyright>
+    Copyright (C) 2026 Team Kodi
+
+    Permission is hereby granted, free of charge, to any person obtaining a
+    copy of this software and associated documentation files (the "Software"),
+    to deal in the Software without restriction, including without limitation
+    the rights to use, copy, modify, merge, publish, distribute, sublicense,
+    and/or sell copies of the Software, and to permit persons to whom the
+    Software is furnished to do so, subject to the following conditions:
+
+    The above copyright notice and this permission notice (including the next
+    paragraph) shall be included in all copies or substantial portions of the
+    Software.
+
+    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <description summary="web views hosted by a media centre compositor">
+    This protocol lets a compositor that hosts a web browser as one of its
+    clients drive the browser's views and learn their state, so that the
+    compositor can present a page as part of its own user interface: open
+    a URL on the user's behalf, navigate, show the title and favicon,
+    offer bookmarks, and hand input to the page while it is in front.
+
+    The compositor spawns the browser itself and the browser connects over
+    an inherited socket. The browser is the Wayland client: requests are
+    what the browser tells the compositor, events are what the compositor
+    asks of the browser.
+
+    Views are grouped by profile. A profile names a hermetic set of
+    cookies, storage and credentials kept by the browser; views of
+    different profiles never share them. The compositor decides which
+    profile a URL opens in and what that profile looks like to the web:
+    user agent, user scripts and content filters are configured per view
+    before the first page loads, as file descriptors the browser reads.
+
+    Warning! The protocol described in this file is experimental and
+    backward incompatible changes may be made. Backward compatible changes
+    may be added together with the corresponding interface version bump.
+    Backward incompatible changes are done by bumping the version number in
+    the protocol and interface names and resetting the interface version.
+  </description>
+
+  <interface name="kodi_web_manager_v1" version="1">
+    <description summary="create and announce web views">
+      The global through which the browser announces itself and creates
+      views. A browser binds it once.
+
+      The compositor asks for a view of a profile with the want_view
+      event; the browser answers with a create_view request for that
+      profile. The browser may also create views on its own, for example
+      the warm default view it keeps ready at start-up. One view per
+      profile: a second create_view for a profile the compositor already
+      knows is a protocol error.
+    </description>
+
+    <enum name="error">
+      <entry name="duplicate_profile" value="0"
+             summary="a view for this profile already exists"/>
+      <entry name="invalid_surface" value="1"
+             summary="the surface already has a role or belongs to another view"/>
+    </enum>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the manager">
+        Destroy the manager. Existing views are unaffected.
+      </description>
+    </request>
+
+    <request name="create_view">
+      <description summary="create a view for a profile">
+        Create a view that renders into the given surface. The surface
+        becomes the view's output and must not have another role; the
+        browser gives it its toplevel role through xdg_wm_base as usual,
+        the compositor configures it fullscreen at its own resolution.
+
+        The profile names the hermetic storage this view uses. The
+        compositor configures the view with set_user_agent,
+        add_user_script and add_content_filter events before its first
+        load_url, so the browser must not load anything into a fresh view
+        on its own.
+      </description>
+      <arg name="id" type="new_id" interface="kodi_web_view_v1"/>
+      <arg name="profile" type="string" summary="profile identifier"/>
+      <arg name="surface" type="object" interface="wl_surface"
+           summary="the surface the view renders into"/>
+    </request>
+
+    <request name="ready">
+      <description summary="the browser is ready to serve views">
+        Sent once the browser's engine processes are up and it can
+        create and load views without further start-up cost. The
+        compositor shows no web entry point as available before it.
+      </description>
+    </request>
+
+    <event name="want_view">
+      <description summary="the compositor wants a view for a profile">
+        The compositor needs a view for the given profile and none exists.
+        The browser answers with create_view for that profile. If it
+        cannot, it answers with a view_unavailable request.
+
+        The uplink names the local source address every connection of
+        the profile's view is bound to, so that a host with more than one
+        uplink can choose the one a profile leaves through. It is an IPv4
+        address, an IPv4 subnet such as 192.168.5.0/24, or an interface
+        name; a subnet or an interface name is resolved for every new
+        connection, so it survives a new DHCP lease. A connection whose
+        uplink does not resolve fails rather than leaving through another
+        uplink. An empty string leaves the connections to the system's
+        routing. A browser that cannot bind connections answers a
+        non-empty uplink with view_unavailable.
+      </description>
+      <arg name="profile" type="string" summary="profile identifier"/>
+      <arg name="uplink" type="string" summary="source address, subnet or interface, or empty"/>
+    </event>
+
+    <request name="view_unavailable">
+      <description summary="a wanted view cannot be created">
+        The browser cannot create the view asked for by want_view, for
+        example because the profile's storage is unusable.
+      </description>
+      <arg name="profile" type="string" summary="profile identifier"/>
+      <arg name="message" type="string" summary="reason, for the log"/>
+    </request>
+  </interface>
+
+  <interface name="kodi_web_view_v1" version="1">
+    <description summary="one web view of one profile">
+      A view is one page container bound to one surface. The compositor
+      drives it with events and learns its state through requests.
+
+      Configuration events (set_user_agent, add_user_script,
+      add_content_filter) apply to this view only and take effect from
+      the next navigation. They arrive before the first load_url of a
+      view the compositor asked for.
+
+      An inactive view keeps its page alive: media keeps playing and
+      scripts keep running, so that the user can leave the page and come
+      back to it. The browser may lower an inactive view's rendering
+      frequency. The compositor stops a view's media by loading
+      about:blank, and discards a view with the close event.
+    </description>
+
+    <enum name="navigation">
+      <entry name="back" value="0" summary="go back in history"/>
+      <entry name="forward" value="1" summary="go forward in history"/>
+      <entry name="reload" value="2" summary="reload the current page"/>
+      <entry name="stop" value="3" summary="stop the current load"/>
+    </enum>
+
+    <enum name="error_code">
+      <description summary="what went wrong with a view">
+        Reported by the error request. The message carries the engine's
+        own text for the log; the code is what the compositor acts on.
+      </description>
+      <entry name="load_failed" value="0"
+             summary="the page could not be loaded"/>
+      <entry name="tls_failed" value="1"
+             summary="the TLS handshake or certificate check failed"/>
+      <entry name="engine_crashed" value="2"
+             summary="the engine process rendering this view terminated"/>
+      <entry name="unresponsive" value="3"
+             summary="the page stopped responding"/>
+    </enum>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the view">
+        The browser is done with the view. Sent in answer to the close
+        event, or on its own when the view can no longer be served, after
+        an error request. The surface loses its role.
+      </description>
+    </request>
+
+    <request name="url_changed">
+      <description summary="the view's URL changed">
+        Sent whenever the committed URL of the view changes, including
+        fragment navigation within the page.
+      </description>
+      <arg name="url" type="string" summary="the current URL"/>
+    </request>
+
+    <request name="title_changed">
+      <description summary="the page title changed">
+        Sent whenever the document title changes. An empty string means
+        the page has no title.
+      </description>
+      <arg name="title" type="string" summary="the current title"/>
+    </request>
+
+    <request name="favicon">
+      <description summary="the page favicon is available">
+        Hands the compositor the page's favicon as an ARGB8888 wl_shm
+        buffer. The compositor copies what it needs and releases the
+        buffer with wl_buffer.release; the browser destroys it after the
+        release. A view sends a new favicon request whenever the icon
+        changes.
+      </description>
+      <arg name="buffer" type="object" interface="wl_buffer"
+           summary="the icon pixels"/>
+    </request>
+
+    <request name="load_progress">
+      <description summary="load progress of the current page">
+        Progress of the current load in percent, 0 at the start of a
+        navigation and 100 when the load finished.
+      </description>
+      <arg name="percent" type="uint" summary="progress from 0 to 100"/>
+    </request>
+
+    <request name="navigation_state">
+      <description summary="history availability changed">
+        Whether the view can go back or forward in its history.
+      </description>
+      <arg name="can_go_back" type="uint" summary="1 if back is possible"/>
+      <arg name="can_go_forward" type="uint" summary="1 if forward is possible"/>
+    </request>
+
+    <request name="error">
+      <description summary="the view failed">
+        Something went wrong with the view. After engine_crashed the
+        browser either recovers the view, in which case it follows up
+        with url_changed, or destroys it.
+      </description>
+      <arg name="code" type="uint" enum="error_code" summary="what went wrong"/>
+      <arg name="message" type="string" summary="engine text, for the log"/>
+    </request>
+
+    <event name="set_user_agent">
+      <description summary="set the user agent of this view">
+        The user agent string this view presents. Takes effect from the
+        next navigation. A view configured without it uses the browser's
+        default.
+      </description>
+      <arg name="user_agent" type="string" summary="user agent string"/>
+    </event>
+
+    <event name="add_user_script">
+      <description summary="inject a user script into this view">
+        A script the browser injects into every document of this view at
+        document start, in the main world, before any page script runs.
+        The script is read from the file descriptor, which the browser
+        closes; the compositor keeps no interest in it afterwards. Scripts
+        apply in the order they are added.
+      </description>
+      <arg name="name" type="string" summary="name, for the log"/>
+      <arg name="fd" type="fd" summary="the script source, UTF-8"/>
+      <arg name="size" type="uint" summary="script size in bytes"/>
+    </event>
+
+    <event name="add_content_filter">
+      <description summary="apply a content filter to this view">
+        A request filter the browser applies to every load of this view,
+        in the content blocker JSON format WebKit and Safari share. The
+        browser compiles it once per name and keeps the compiled form
+        across runs; a filter sent again under the same name replaces the
+        earlier one.
+      </description>
+      <arg name="name" type="string" summary="filter identifier"/>
+      <arg name="fd" type="fd" summary="the filter rules, UTF-8 JSON"/>
+      <arg name="size" type="uint" summary="rules size in bytes"/>
+    </event>
+
+    <event name="load_url">
+      <description summary="load a URL">
+        Navigate the view to the URL. about:blank unloads the page and
+        stops its media.
+      </description>
+      <arg name="url" type="string" summary="the URL to load"/>
+    </event>
+
+    <event name="navigate">
+      <description summary="history and load control">
+        Go back or forward, reload, or stop the current load.
+      </description>
+      <arg name="action" type="uint" enum="navigation" summary="what to do"/>
+    </event>
+
+    <event name="set_active">
+      <description summary="the view is shown or hidden">
+        Active means the compositor presents the view's surface and routes
+        input to it. An inactive view keeps running and may render less
+        often; it must still commit a frame when its content changes, so
+        that the compositor has a current picture when it activates the
+        view again.
+      </description>
+      <arg name="active" type="uint" summary="1 while the view is presented"/>
+    </event>
+
+    <event name="close">
+      <description summary="the compositor is done with the view">
+        The browser unloads the page, unmaps the surface and destroys the
+        view. The profile's storage stays.
+      </description>
+    </event>
+  </interface>
+</protocol>
