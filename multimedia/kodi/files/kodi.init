#!/bin/sh /etc/rc.common

START=99
# Stop early and in order, so the splash can take the display over.
STOP=05
USE_PROCD=1

KODI_USER=kodi

kodi_data_dir() {
	local dir
	config_load kodi
	config_get dir main data_dir /srv/kodi
	echo "$dir"
}

kodi_temp_dir() {
	local dir
	config_load kodi
	config_get dir main temp_dir /tmp/kodi
	echo "$dir"
}

is_mounted() {
	awk -v target="$1" '$2 == target { found = 1 } END { exit !found }' /proc/mounts
}

start_service() {
	local data_dir="$(kodi_data_dir)"
	local temp_dir="$(kodi_temp_dir)"
	local volume="$(procd_get_mountpoints "$data_dir")"
	local i

	# The data directory can live on its own volume, which blockd mounts
	# well after we are first started. Leave it to the mount trigger
	# rather than starting on an empty directory in the rootfs.
	if [ -n "$volume" ] && ! is_mounted "$volume"; then
		echo "kodi: waiting for $volume" >&2
		return 0
	fi

	# Kodi's GBM windowing needs a KMS device with connectors; the DRM
	# driver stack is modular and can bind well after procd starts us.
	# Wait (bounded) for a connector to appear instead of starting
	# headless - kodi does not retry DRM init once it is up.
	for i in $(seq 1 30); do
		[ -n "$(ls /sys/class/drm/card*-*/status 2>/dev/null)" ] && break
		sleep 1
	done

	# Plymouth holds DRM master until told otherwise, which would fail
	# kodi's own drmSetMaster. Retaining the splash keeps the mode and
	# the last frame up over the gap until kodi draws.
	# --wait, because quit returns as soon as the command is sent and
	# kodi would race plymouthd for drm master.
	[ -x /usr/bin/plymouth ] && \
		/usr/bin/plymouth quit --retain-splash --wait

	mkdir -p "$data_dir" "$temp_dir"
	chown "$KODI_USER:$KODI_USER" "$data_dir" "$temp_dir"

	procd_open_instance
	procd_set_param command /usr/lib/kodi/kodi.bin --standalone --windowing=gbm
	procd_set_param user "$KODI_USER"
	procd_set_param group "$KODI_USER"
	# PIPEWIRE_RUNTIME_DIR: the shared system-mode socket directory, which
	# kodi reaches through its membership in the 'audio' group
	procd_set_param env HOME="$temp_dir" KODI_DATA="$data_dir" \
		KODI_TEMP="$temp_dir" PIPEWIRE_RUNTIME_DIR=/var/run/pipewire
	# Same limits the pipewire services get: libpipewire is linked into kodi
	# and its module-rt gives the audio thread realtime priority through
	# sched_setscheduler. Denied, it falls back to the RTKit D-Bus path,
	# which has no session bus to talk to here and takes kodi down with it.
	procd_set_param limits rtprio="95 95" nice="40 40"
	procd_set_param respawn 3600 5 0
	# Shutdown persists the EPG and tears down each PVR client in turn,
	# which overruns procd's five second default and gets kodi killed
	# mid-write on every stop.
	procd_set_param term_timeout 20
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger kodi
	procd_add_restart_mount_trigger "$(kodi_data_dir)"
}
