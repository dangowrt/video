#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	mkdir -p /var/lib/kodi
	procd_open_instance
	procd_set_param command /usr/bin/kodi-standalone --windowing=gbm
	procd_set_param env HOME=/var/lib/kodi
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
