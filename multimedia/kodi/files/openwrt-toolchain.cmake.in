set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_VERSION 1)
set(CMAKE_SYSTEM_PROCESSOR @ARCH@)

set(CMAKE_C_COMPILER "@CC@")
set(CMAKE_CXX_COMPILER "@CXX@")
set(CMAKE_ASM_COMPILER "@CC@")
set(CMAKE_C_COMPILER_LAUNCHER "@LAUNCHER@")
set(CMAKE_CXX_COMPILER_LAUNCHER "@LAUNCHER@")
set(CMAKE_ASM_COMPILER_LAUNCHER "@LAUNCHER@")
set(CMAKE_AR "@AR@")
set(CMAKE_NM "@NM@")
set(CMAKE_RANLIB "@RANLIB@")

set(CMAKE_C_FLAGS_INIT "@CFLAGS@")
set(CMAKE_CXX_FLAGS_INIT "@CXXFLAGS@")
set(CMAKE_C_FLAGS_RELEASE_INIT "-DNDEBUG")
set(CMAKE_CXX_FLAGS_RELEASE_INIT "-DNDEBUG")
set(CMAKE_EXE_LINKER_FLAGS_INIT "@LDFLAGS@")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "@LDFLAGS@")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "@LDFLAGS@")

set(CMAKE_FIND_ROOT_PATH "@FIND_ROOT_PATH@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_SKIP_RPATH TRUE)
