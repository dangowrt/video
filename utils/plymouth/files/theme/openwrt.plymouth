[Plymouth Theme]
Name=OpenWrt
Description=The OpenWrt mark with its signal arcs filling like wireless bars
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/openwrt
HorizontalAlignment=.5
VerticalAlignment=.5
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x002b49
BackgroundEndColor=0x001b2e
ProgressBarBackgroundColor=0x0a4a6a
ProgressBarForegroundColor=0x00b5e2
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
UseProgressBar=true

[system-upgrade]
SuppressMessages=true
UseProgressBar=true

[firmware-upgrade]
SuppressMessages=true
UseProgressBar=true

[system-reset]
SuppressMessages=true
UseProgressBar=true
